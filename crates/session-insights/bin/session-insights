#!/bin/sh
# session-insights plugin launcher — selects the per-platform binary bundled in this dir.
#
# Hooks call `${CLAUDE_PLUGIN_ROOT}/bin/session-insights <record|sessionend|stop>`; this dispatcher execs the
# matching `session-insights-<os>-<arch>` build.
#
# WHEN NO BUILD EXISTS FOR THE HOST, the answer is NOT a blanket "exit 0"
# (backlog 8aeb4cab). Exit 0 with empty stdout is what the binary itself
# prints when it ran and had nothing to say, so a silent exit 0 here made
# "did not run" indistinguishable from "checked, nothing to report" — and for
# a CLI verb, exit 0 is the success code (CLAUDE.md §1/§3). The fallback is
# chosen per consumer of each entrypoint:
#
#   record         PostToolUse, per tool call. EXEMPT from a visible message: its only
#                  readers are `session-insights stop` (surfaces a systemMessage
#                  every turn) and `report` (exits 127) — the same missing
#                  binary — so nothing can read the missing count as zero.
#                  -> EXEMPT: stderr line, exit 0 (consumers listed above).
#   stop           Stop. Recording only; consumer: `session-insights report` / the vault note.
#                  -> stdout JSON systemMessage (the user is the only consumer). exit 0 —
#                  no verdict to protect, so no block.
#   sessionend     SessionEnd.
#                  -> SessionEnd: Claude Code discards stdout/JSON; stderr is the only
#                  channel, so exit 1 (non-blocking hook error + stderr line).
#
#   anything else  A CLI verb (or a hook verb with extra args, e.g. `--json`).
#                  Exits 127 ("command not found") with the reason on stderr:
#                  the result is UNKNOWN, and no caller may read the missing
#                  output as the success code. 127 is outside every verb's
#                  exit-code vocabulary in this crate.
#
# None of these block: no entrypoint here carries a verdict whose block the
# binary would issue, so the fallback makes the gap VISIBLE instead.
# scripts/tests/launcher-missing-binary-failclosed.sh pins this behaviour.
root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *)      os="$(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64)   arch=x86_64 ;;
  arm64|aarch64)  arch=arm64 ;;
  *)              arch="$(uname -m)" ;;
esac

ext=""
[ "$os" = windows ] && ext=".exe"

binary="$root/session-insights-$os-$arch$ext"
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

echo "session-insights: no bundled binary for $os-$arch ($binary)." >&2
fix="Build it with scripts/build-plugin-bin.sh for $os-$arch, or remove the session-insights plugin."

case "$*" in
  "record")
    echo "session-insights record did NOT run (no bundled binary for $os-$arch); this tool call was NOT counted. $fix" >&2
    exit 0
    ;;
  "stop")
    msg="session-insights stop did NOT run: no bundled binary for $os-$arch, so this session's tool/turn counts and session note are NOT being recorded; any report would be incomplete, not small. $fix"
    printf '{"systemMessage":"%s"}\n' "$msg"
    exit 0
    ;;
  "sessionend")
    echo "session-insights sessionend did NOT run: no bundled binary for $os-$arch, so no session note was written. $fix" >&2
    exit 1
    ;;
esac

echo "session-insights: '$*' did NOT run (no bundled binary for $os-$arch), so its result is UNKNOWN — not empty and not success. $fix" >&2
exit 127
