#!/bin/sh
# compass plugin launcher — selects the per-platform binary bundled in this dir.
#
# Hooks call `${CLAUDE_PLUGIN_ROOT}/bin/compass <breadcrumb|nudge>`; this dispatcher execs the
# matching `compass-<os>-<arch>` build.
#
# WHEN NO BUILD EXISTS FOR THE HOST, the answer is NOT a blanket "exit 0"
# (backlog 8aeb4cab). Exit 0 with empty stdout is what the binary itself
# prints when it ran and had nothing to say, so a silent exit 0 here made
# "did not run" indistinguishable from "checked, nothing to report" — and for
# a CLI verb, exit 0 is the success code (CLAUDE.md §1/§3). The fallback is
# chosen per consumer of each entrypoint:
#
#   nudge          SessionStart. The binary is silent iff the charter is fresh, so silence
#                  is a freshness verdict read by the model. (`nudge --json`,
#                  the machine gate, is a CLI verb and exits 127.)
#                  -> stdout JSON: additionalContext (the model reads this hook's silence as
#                  'nothing to report') + systemMessage (the user). exit 0.
#   breadcrumb     Stop. Side-effect writer of next_action; never blocks in the binary.
#                  Consumer: the next /compass read of the charter (the human).
#                  -> stdout JSON systemMessage (the user is the only consumer). exit 0 —
#                  no verdict to protect, so no block.
#
#   anything else  A CLI verb (or a hook verb with extra args, e.g. `--json`).
#                  Exits 127 ("command not found") with the reason on stderr:
#                  the result is UNKNOWN, and no caller may read the missing
#                  output as the success code. 127 is outside every verb's
#                  exit-code vocabulary in this crate.
#
# None of these block: no entrypoint here carries a verdict whose block the
# binary would issue, so the fallback makes the gap VISIBLE instead.
# scripts/tests/launcher-missing-binary-failclosed.sh pins this behaviour.
root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *)      os="$(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64)   arch=x86_64 ;;
  arm64|aarch64)  arch=arm64 ;;
  *)              arch="$(uname -m)" ;;
esac

ext=""
[ "$os" = windows ] && ext=".exe"

binary="$root/compass-$os-$arch$ext"
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

echo "compass: no bundled binary for $os-$arch ($binary)." >&2
fix="Build it with scripts/build-plugin-bin.sh for $os-$arch, or remove the compass plugin."

case "$*" in
  "nudge")
    msg="compass nudge did NOT run: no bundled binary for $os-$arch. Charter freshness (C1 existence/blurry, C2 staleness) was NOT evaluated, so it is UNKNOWN; the absence of a nudge is NOT a fresh charter. $fix"
    printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$msg" "$msg"
    exit 0
    ;;
  "breadcrumb")
    msg="compass breadcrumb did NOT run: no bundled binary for $os-$arch, so next_action in .compass/charter.md was NOT updated from this turn and may be stale. $fix"
    printf '{"systemMessage":"%s"}\n' "$msg"
    exit 0
    ;;
esac

echo "compass: '$*' did NOT run (no bundled binary for $os-$arch), so its result is UNKNOWN — not empty and not success. $fix" >&2
exit 127
