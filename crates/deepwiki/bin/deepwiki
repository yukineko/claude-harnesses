#!/bin/sh
# deepwiki plugin launcher — selects the per-platform binary bundled here.
#
# The /deepwiki command calls `${CLAUDE_PLUGIN_ROOT}/bin/deepwiki <sub>`; this
# execs the matching `deepwiki-<os>-<arch>` build.
#
# WHEN NO BUILD EXISTS FOR THE HOST, the answer is NOT "exit 0". deepwiki has no
# hook wiring at all (crates/deepwiki/hooks/ does not exist), so there is no
# hook-event vocabulary to speak and no turn to protect. Every consumer reads
# stdout as DATA and would read an empty result as a real answer:
#
#   * crates/deepwiki/commands/deepwiki.md  (the /deepwiki command)
#   * crates/compass/skills/compass/SKILL.md
#   * crates/condukt/skills/condukt/SKILL.md
#   * crates/scout/skills/scout/SKILL.md
#
# So: print nothing on stdout and exit non-zero (CLAUDE.md §1/§3).
root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *)      os="$(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64)   arch=x86_64 ;;
  arm64|aarch64)  arch=arm64 ;;
  *)              arch="$(uname -m)" ;;
esac

ext=""
[ "$os" = windows ] && ext=".exe"

binary="$root/deepwiki-$os-$arch$ext"
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

echo "deepwiki: no bundled binary for $os-$arch ($binary). The lookup did NOT run, so its result is UNKNOWN — this is not an empty answer. Build it with scripts/build-plugin-bin.sh on that platform." >&2
exit 1
