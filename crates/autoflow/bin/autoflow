#!/bin/sh
# autoflow plugin launcher — selects the per-platform binary bundled in this dir.
#
# Hooks call `${CLAUDE_PLUGIN_ROOT}/bin/autoflow <sub>`; this dispatcher execs
# the matching `autoflow-<os>-<arch>` build.
#
# WHEN NO BUILD EXISTS FOR THE HOST, the answer is NOT a blanket "exit 0". A
# missing binary means the hook DID NOT RUN — a cannot-determine — and exit 0
# with no output is byte-for-byte what a clean run looks like (CLAUDE.md §1/§3;
# the old comment here said "it exits 0 silently so a hook NEVER breaks the
# user's turn", the exact sentence §1 names as the red flag). This dispatcher
# resolves the unknown on the restrictive side of each subcommand's OWN
# protocol, mirroring crates/ctxrot/bin/ctxrot.
#
# Classification (all three subcommands are hook entrypoints; hooks.json):
#
#   verdict-bearing (silence would be read as "nothing to flag"):
#     stop           Stop          -> {"decision":"block"}. `stop_command`
#                    (src/main.rs:128, emitting at :435) is a blocking gate, so
#                    no stdout = the turn ends as if the progress/loop state
#                    machine had run and passed. Blocks on this gate's FIRST
#                    failure in a session — including a `stop_hook_active`
#                    re-entry caused by ANOTHER gate's block — bounded exactly
#                    like harness_core::gate::run::run_guarded's panic barrier:
#                    only this gate's SECOND CONSECUTIVE failure in the session
#                    is allowed through (per-gate, per-session marker, see
#                    `streak_decide` below), so a missing binary can never trap
#                    the session.
#                    (RETIRED 2026-08-20: `session-start` used to be classified
#                    here too, because `session_start_command` proposed `/flow`
#                    from the backlog queue and a missing binary had to speak its
#                    Undetermined sentence rather than fall silent. The
#                    subcommand and its hook are gone on the user's instruction,
#                    so the arg now falls through to the catch-all `exit 1`
#                    below. That is the honest answer for an invocation nothing
#                    makes: a hook that no longer exists must not be given a
#                    successful-looking reply.)
#
#   non-verdict (exit 0, but never silent — the stderr line below is the
#   "did not run" signal):
#     pre-compact    PreCompact       writes a resume-flow marker
#     prompt-submit  UserPromptSubmit consumes that marker
#                    These two are a writer and its ONLY reader, and both live
#                    in this one binary: `prompt_submit_run` (src/main.rs:620)
#                    reads only what `pre-compact` wrote. When the binary is
#                    missing, neither runs, so there is no consumer left to
#                    mistake the absent marker for "nothing to resume" — the
#                    session behaves exactly as one where these hooks were
#                    never installed. Fabricating stdout here would instead
#                    inject a line into EVERY user prompt.
#
#   anything else -> exit 1 (an unrecognised invocation must not look like a
#   clean empty result).
root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *)      os="$(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64)   arch=x86_64 ;;
  arm64|aarch64)  arch=arm64 ;;
  *)              arch="$(uname -m)" ;;
esac

ext=""
[ "$os" = windows ] && ext=".exe"

binary="$root/autoflow-$os-$arch$ext"
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

echo "autoflow: no bundled binary for $os-$arch ($binary)." >&2

fix="Build it with scripts/build-plugin-bin.sh for $os-$arch, or remove the autoflow hooks."

# ---- missing-binary failure streak, bounded exactly like run_guarded --------
# `stop_hook_active` is set whenever ANY Stop hook blocked the previous stop, so
# on its own it says nothing about THIS gate (backlog 9b3f98ec). Only a SECOND
# CONSECUTIVE failure of THIS gate in THIS session may allow (CLAUDE.md §1). The
# streak is the same per-gate, per-session marker run_guarded keeps for panics
# (crates/harness-core/src/gate/run.rs `PanicMarker`):
#   $HOME/.harness/state/panic-markers/<gate>/<session>.panic
# read-and-cleared on every stop and re-written when this stop fails. Sharing the
# path means a run of the real binary (run_guarded clears it up front) resets the
# streak, and a missing binary followed by a panic counts as consecutive. The
# decision table mirrors run_guarded's `decide`:
#   first stop of a chain              -> record, block (whatever the record did)
#   re-entry, previous stop failed     -> record, allow (stderr only)
#   re-entry, previous stop did not    -> record; block, or loud allow if the
#                                         record failed (a block that cannot be
#                                         recorded could never be bounded)
#   re-entry, streak undetermined (no usable session id, HOME unset, marker not
#   clearable)                         -> loud allow: systemMessage on stdout
# Sets $streak (block|allow|loud) and $streak_why.
streak_record() {
  [ -n "$streak_marker" ] || return 1
  mkdir -p "$streak_dir" 2>/dev/null || return 1
  printf 'missing-binary\n' > "$streak_marker" 2>/dev/null
}
streak_decide() {
  # $1 = Stop payload, $2 = yes when stop_hook_active is true, $3 = gate name
  streak_why=""
  streak_marker=""
  streak_dir=""
  if printf '%s' "$1" | grep -q '"session_id"'; then
    streak_sid="$(printf '%s' "$1" | tr -d '\n' | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p')"
  else
    streak_sid="${CLAUDE_CODE_SESSION_ID:-}"
  fi
  case "$streak_sid" in
    ''|.|..|_local|*/*|*\\*) streak_sid="" ;;
  esac
  if [ -z "$streak_sid" ]; then
    streak_why="no usable session id, so this gate's previous-stop failure cannot be looked up"
  elif [ -z "${HOME:-}" ]; then
    streak_why="HOME is unset, so the failure-streak marker cannot be located"
  else
    streak_dir="$HOME/.harness/state/panic-markers/$3"
    streak_marker="$streak_dir/$streak_sid.panic"
  fi
  streak_prev=no
  if [ -z "$streak_marker" ]; then
    streak_prev=undetermined
  elif [ -e "$streak_marker" ] || [ -L "$streak_marker" ]; then
    if rm -f "$streak_marker" 2>/dev/null && ! [ -e "$streak_marker" ] && ! [ -L "$streak_marker" ]; then
      streak_prev=yes
    else
      streak_prev=undetermined
      streak_why="the failure-streak marker exists but could not be cleared"
      streak_marker=""
    fi
  fi
  if [ "$2" != yes ]; then
    streak_record || echo "$3: failure-streak marker not recorded; the next re-entry cannot see it." >&2
    streak=block
    return 0
  fi
  case "$streak_prev" in
    yes)
      streak_record || echo "$3: failure-streak marker not recorded." >&2
      streak=allow
      ;;
    no)
      if streak_record; then
        streak=block
      else
        streak=loud
        streak_why="this first failure on a re-entry could not be recorded, so a block here could never be bounded"
      fi
      ;;
    *)
      streak=loud
      ;;
  esac
}

case "${1:-}" in
  stop)
    if [ -t 0 ]; then
      echo "autoflow: no Stop event (stdin is a terminal) — a decision will NOT be fabricated for a manual invocation. $fix" >&2
      exit 1
    fi
    payload="$(cat)"
    if [ -z "$(printf '%s' "$payload" | tr -d '[:space:]')" ]; then
      echo "autoflow: no Stop event on stdin — a decision will NOT be fabricated for a manual invocation. $fix" >&2
      exit 1
    fi
    reentry=no
    if printf '%s' "$payload" | grep -q '"stop_hook_active"[[:space:]]*:[[:space:]]*true'; then
      reentry=yes
    fi
    streak_decide "$payload" "$reentry" autoflow
    case "$streak" in
      allow)
        echo "autoflow: no binary again on this gate's consecutive stop — allowing this stop (the fail-closed block was already surfaced for this gate's previous stop in this session; the loop/progress state machine still has NOT run)." >&2
        exit 0
        ;;
      loud)
        echo "autoflow: stop re-entry with no binary and an undetermined failure streak ($streak_why) — allowing loudly." >&2
        printf '{"systemMessage":"%s"}\n' \
          "autoflow stop did not run on a stop re-entry (no bundled binary for $os-$arch) and did NOT check this stop. Whether its previous stop also failed could not be determined ($streak_why), and blocking without that record could loop forever, so this stop is allowed. Treat this stop as unchecked by autoflow. $fix"
        exit 0
        ;;
    esac
    printf '{"decision":"block","reason":"%s"}\n' \
      "autoflow stop did not run: no bundled binary for $os-$arch, so the record/condukt progress state machine was NOT evaluated. This stop is therefore UNCHECKED, not approved (blocked fail-closed — only if autoflow also finds no binary on its very next stop in this session is that stop allowed through, so the session can never be trapped). $fix"
    exit 0
    ;;
  pre-compact|prompt-submit)
    echo "autoflow: $1 did not run (no binary) — no resume-flow marker was written or consumed. Since pre-compact is the only writer and prompt-submit the only reader, and both are this same missing binary, nothing downstream can misread the absence. $fix" >&2
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
