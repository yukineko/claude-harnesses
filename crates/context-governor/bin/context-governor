#!/bin/sh
# context-governor plugin launcher — selects the per-platform binary bundled in this dir.
#
# Hooks call `${CLAUDE_PLUGIN_ROOT}/bin/context-governor`; this dispatcher execs the
# matching `context-governor-<os>-<arch>` build.
#
# WHEN NO BUILD EXISTS FOR THE HOST, the answer is NOT a blanket "exit 0"
# (backlog 8aeb4cab). Exit 0 with empty stdout is what the binary itself
# prints when it ran and had nothing to say, so a silent exit 0 here made
# "did not run" indistinguishable from "checked, nothing to report" — and for
# a CLI verb, exit 0 is the success code (CLAUDE.md §1/§3). The fallback is
# chosen per consumer of each entrypoint:
#
#   (no args)      The single hook entrypoint for six events; the event is
#                  read from stdin's hook_event_name:
#                  PostToolUse -> additionalContext only (per tool call);
#                  UserPromptSubmit / SessionStart -> additionalContext +
#                  systemMessage (the model reads silence as nothing to
#                  inject); PreCompact / Stop / SubagentStop -> systemMessage.
#                  PreCompact does not block: the binary's CompactionGuard
#                  proceeds unconditionally (src/defaults/guard.rs), so there
#                  is no block to mirror, and an unbounded block of compaction
#                  would trap the session. Unknown/absent event -> 127.
#
#   anything else  A CLI verb (or a hook verb with extra args, e.g. `--json`).
#                  Exits 127 ("command not found") with the reason on stderr:
#                  the result is UNKNOWN, and no caller may read the missing
#                  output as the success code. 127 is outside every verb's
#                  exit-code vocabulary in this crate.
#
# None of these block: no entrypoint here carries a verdict whose block the
# binary would issue, so the fallback makes the gap VISIBLE instead.
# scripts/tests/launcher-missing-binary-failclosed.sh pins this behaviour.
root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *)      os="$(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64)   arch=x86_64 ;;
  arm64|aarch64)  arch=arm64 ;;
  *)              arch="$(uname -m)" ;;
esac

ext=""
[ "$os" = windows ] && ext=".exe"

binary="$root/context-governor-$os-$arch$ext"
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

echo "context-governor: no bundled binary for $os-$arch ($binary)." >&2
fix="Build it with scripts/build-plugin-bin.sh for $os-$arch, or remove the context-governor plugin."

case "$*" in
  "")
    if [ -t 0 ]; then
      echo "context-governor: no hook event on stdin (terminal) and no binary to run. $fix" >&2
      exit 127
    fi
    payload="$(cat)"
    event="$(printf '%s' "$payload" | tr '\n' ' ' | sed -n 's/.*"hook_event_name"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p')"
    case "$event" in
      PostToolUse)
        msg="context-governor did NOT run (no bundled binary for $os-$arch): this tool result was NOT deduplicated or ledgered, so a missing already-seen hint is UNKNOWN, not new content. $fix"
        printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"%s"}}\n' "$msg"
        exit 0
        ;;
      UserPromptSubmit)
        msg="context-governor UserPromptSubmit did NOT run: no bundled binary for $os-$arch. No context was injected for this prompt, so its absence is UNKNOWN, not nothing to inject. $fix"
        printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$msg" "$msg"
        exit 0
        ;;
      SessionStart)
        msg="context-governor SessionStart did NOT run: no bundled binary for $os-$arch. State was NOT rehydrated, so the absence of rehydrated context is UNKNOWN, not nothing to restore. $fix"
        printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$msg" "$msg"
        exit 0
        ;;
      PreCompact)
        msg="context-governor PreCompact did NOT run: no bundled binary for $os-$arch, so NO checkpoint was written before this compaction. $fix"
        printf '{"systemMessage":"%s"}\n' "$msg"
        exit 0
        ;;
      Stop)
        msg="context-governor Stop did NOT run: no bundled binary for $os-$arch, so this turn was NOT checkpointed. $fix"
        printf '{"systemMessage":"%s"}\n' "$msg"
        exit 0
        ;;
      SubagentStop)
        msg="context-governor SubagentStop did NOT run: no bundled binary for $os-$arch, so this subagent turn was NOT checkpointed. $fix"
        printf '{"systemMessage":"%s"}\n' "$msg"
        exit 0
        ;;
    esac
    echo "context-governor: no recognisable hook_event_name on stdin (got: ${event:-none}) and no binary to handle it." >&2
    exit 127
    ;;
esac

echo "context-governor: '$*' did NOT run (no bundled binary for $os-$arch), so its result is UNKNOWN — not empty and not success. $fix" >&2
exit 127
