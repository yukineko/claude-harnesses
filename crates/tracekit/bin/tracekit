#!/bin/sh
# tracekit plugin launcher — selects the per-platform binary bundled in this dir.
#
# WHEN NO BUILD EXISTS FOR THE HOST, the answer is NOT "exit 0". tracekit has no
# hook wiring at all (crates/tracekit/hooks/ does not exist), so there is no
# hook-event vocabulary to speak and no turn to protect. Its consumers are:
#
#   * the human CLI / `/tracekit`-style manual invocation — `list`, `trace
#     <run>` and `export` all print a SPAN SET, so an empty stdout with exit 0
#     reads as "this run has no spans", not as "the span store was never
#     opened" (CLAUDE.md §1/§3).
#   * replaykit — which reads ~/.tracekit/<run_id>/spans.jsonl straight off
#     disk (crates/replaykit/README.md), NOT through this binary, so it is
#     unaffected either way.
#
# The previous version of this comment justified `exit 0` by claiming
# "condukt's state-set calls `tracekit record` opportunistically". That is not
# true of the code: `grep -rn tracekit crates/condukt/src/` returns ZERO hits
# (measured 2026-08-11 at d48c7133). The claim is removed rather than kept as a
# safe-sounding story (CLAUDE.md §4).
root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *)      os="$(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64)   arch=x86_64 ;;
  arm64|aarch64)  arch=arm64 ;;
  *)              arch="$(uname -m)" ;;
esac

ext=""
[ "$os" = windows ] && ext=".exe"

binary="$root/tracekit-$os-$arch$ext"
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

echo "tracekit: no bundled binary for $os-$arch ($binary). Nothing was recorded or read, so the span set is UNKNOWN — this is not an empty trace. Build it with scripts/build-plugin-bin.sh on that platform." >&2
exit 1
