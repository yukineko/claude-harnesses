/target
**/*.rs.bk
Cargo.lock.bak
.DS_Store

# machine-local cargo overrides (e.g. target-dir redirect for a full C: drive
# under WSL) — not something every contributor's machine needs
/.cargo/

# precommit-audit runtime telemetry (append-only, machine-local)
.claude/audit-log.jsonl

# ephemeral session/tool state
.claude/progress.md
.compass/carve-state.json
.compass/outcomes.json
.tdd/

# deterministic code index (rebuildable from source via `fugu-router code-index build`)
.fugu/

# Python bytecode cache
__pycache__/
*.pyc

# crate-local runtime progress artifacts (taskprog etc.) — never track
crates/*/.claude/

# compiled per-platform plugin binaries — NEVER committed (personal repo, no
# distribution). Local deploy builds from source: rollout/rebuild run
# `cargo build --release` and copy target/release/<name> into the live plugin
# cache. Only the platform-tagged artifacts are ignored; the hand-written
# bin/<name> wrapper dispatchers (no -os-arch tag) stay tracked.
crates/*/bin/*-darwin-arm64
crates/*/bin/*-darwin-x86_64
crates/*/bin/*-linux-arm64
crates/*/bin/*-linux-x86_64
