#!/bin/sh
# Versioned pre-commit hook — the PRIMARY gate surface of this repository.
# Enable once per clone with:
#
#     git config core.hooksPath .githooks
#
# Opt-in by construction: a clone that never runs that command gets no hook at
# all. Nothing here assumes GitHub, a hosted CI, or any network service, so it
# works identically on CodeCommit or a bare local repo.
#
# Why the gate lives HERE and not in CI
# -------------------------------------
# Enforcement used to be pinned to four GitHub required status checks. That
# arrangement failed in all three ways an external dependency can fail, on the
# day it was introduced:
#   * it blocked a correct fix (PR #24),
#   * the block was invisible from the machine that wrote the code — the author
#     could truthfully report success while the change was un-mergeable, and
#   * removing it needed a permission the local token did not hold.
# Commit time is where the loop is shortest: the agent that wrote the defect is
# still holding the context needed to fix it. It is also the only point that
# protects LOCAL main, where condukt fast-forward merges land first.
#
# What runs (all stdlib-only python3; each blocks, none warn-and-continue)
# -----------------------------------------------------------------------
#   injectguard        check-prompt-injection.py  planted prompt-injection in a
#                                                 committed prompt asset
#   fail-open-guard    check-fail-open.py         a new fail-open swallow on the
#                                                 gate surface
#   doc-claims         check-doc-claims.py        a `path:line` citation in
#                                                 docs/**/*.md that no longer
#                                                 describes reality
#   claudemd-claims    check-claudemd-claims.py   a `path:line` citation in
#                                                 CLAUDE.md itself that no
#                                                 longer describes reality —
#                                                 the dedicated gate for the
#                                                 norm/instruction file, split
#                                                 out of doc-claims so an
#                                                 instruction file is not
#                                                 folded into documentation
#                                                 verification. No bypass flag.
#   test-weakening     check-test-weakening.py    a change that weakens the test
#                                                 surface instead of the code
#   version-lockstep   check-plugin-versions.py   the three version files of a
#                                                 plugin disagreeing
#   bump-on-change     check-version-bumped.py    a touched plugin left un-bumped
#   secret-guard       check-hardcoded-secret.py  a password/token/api-key/
#                                                 secret literal in added lines
#                                                 (backlog aa74be67; closes the
#                                                 gap recorded in
#                                                 crates/precommit-audit/README
#                                                 .ja.md's self-apply section)
#   raw-io-ratchet     check-raw-io-ratchet.py    a new raw stdlib read_dir/
#                                                 read_to_string/Command::new
#                                                 call in GATE_CRATES src/,
#                                                 bypassing the fallible
#                                                 harness_core::boundary
#                                                 wrappers (compass DoD item 4,
#                                                 north_star "close the
#                                                 fail-open ENTRANCE with types
#                                                 and lints")
#
# Plus one Rust gate (not python3):
#   main-tree-guard    condukt guard main-tree    a commit from the SHARED primary
#                                                 working tree while another
#                                                 session is live (CLAUDE.md §8)
#
# The binary-reproducibility gate stays out: it rebuilds every bin from source,
# which is far too slow for a commit.
#
# Fail-closed contract (repo doctrine: "cannot determine" resolves to the
# restricted side, never to "fine")
# ------------------------------------------------------------------------
# Every non-zero scanner exit blocks, and the distinction is preserved in the
# message rather than in the outcome: check-test-weakening.py exits 1 for a
# finding and 2 for "the verdict could not be determined at all", and BOTH stop
# the commit. A missing python3 or a missing scanner file also blocks. That is a
# deliberate change from the previous version of this hook, which skipped both
# and exited 0 — defensible only while CI was the real enforcer, and this hook
# is now the real enforcer.
#
# `git commit --no-verify` still bypasses everything. That is a real hole and it
# is stated rather than hidden: there is no longer a required status check
# standing behind it. It is accepted because the bypass is explicit, typed by a
# human, and visible in the shell history — unlike the failure mode it replaces,
# which was silent.

set -u

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "pre-commit: not inside a git work tree — refusing to certify this commit" >&2
    exit 1
}

if ! command -v python3 >/dev/null 2>&1; then
    cat >&2 <<'EOF'
pre-commit: python3 not found, so NONE of the local gates could run.

"Could not check" is not "clean", so this commit is blocked rather than waved
through. Install python3, or bypass deliberately with `git commit --no-verify`.
EOF
    exit 1
fi

rc=0

# run <scanner-basename> <human-label>
# Blocks on any non-zero exit AND on the scanner file being absent. The scanner
# prints its own diagnostic; this adds the label so a reader knows which gate
# spoke, and names exit 2 as undetermined rather than letting it read as a
# generic failure.
run() {
    scanner="$1"
    label="$2"
    path="$REPO/scripts/$scanner"

    if [ ! -f "$path" ]; then
        echo "" >&2
        echo "$label: scripts/$scanner is missing — cannot determine, so blocking." >&2
        echo "  (restore the file, or bypass deliberately with --no-verify)" >&2
        rc=1
        return
    fi

    python3 "$path"
    status=$?
    [ "$status" -eq 0 ] && return

    echo "" >&2
    if [ "$status" -eq 2 ]; then
        echo "$label: UNDETERMINED (exit 2) — the gate could not reach a verdict." >&2
        echo "  This blocks. An uninspected surface is not a clean surface; fix" >&2
        echo "  what stopped the scanner rather than loosening it to pass." >&2
    else
        echo "$label: blocked (exit $status)." >&2
    fi
    rc=1
}

run check-prompt-injection.py injectguard
run check-fail-open.py        fail-open-guard
run check-doc-claims.py       doc-claims
run check-claudemd-claims.py  claudemd-claims
run check-test-weakening.py   test-weakening
run check-plugin-versions.py  version-lockstep
run check-version-bumped.py   bump-on-change
run check-hardcoded-secret.py secret-guard
run check-raw-io-ratchet.py   raw-io-ratchet

# main-tree-guard — CLAUDE.md §8, the one gate here that is Rust rather than
# python3, because its decision is a tri-state over injectable inputs and is
# unit-tested (crates/condukt/src/maintree.rs). It refuses a commit made from
# the SHARED primary working tree while another session is live; it passes from
# a linked worktree, during an integration, with nothing staged, or when no peer
# session is reported.
#
# The binary is resolved with a freshly built one first, because a condukt on
# PATH that predates `guard main-tree` answers "unrecognized subcommand" (exit
# 2) — which blocks, as an unrunnable gate must. Build with
# `cargo build --release -p condukt`, or roll the plugin out, rather than
# loosening this.
guard_bin=""
for cand in "${CONDUKT_BIN:-}" "$REPO/target/release/condukt" "$REPO/target/debug/condukt"; do
    if [ -n "$cand" ] && [ -x "$cand" ]; then
        guard_bin="$cand"
        break
    fi
done
if [ -z "$guard_bin" ]; then
    guard_bin="$(command -v condukt 2>/dev/null)" || guard_bin=""
fi

if [ -z "$guard_bin" ]; then
    echo "" >&2
    echo "main-tree-guard: no condukt binary found (tried \$CONDUKT_BIN, target/release," >&2
    echo "  target/debug, PATH) — the §8 gate could not run, so this blocks." >&2
    echo "  Build it: cargo build --release -p condukt" >&2
    rc=1
else
    "$guard_bin" guard main-tree
    guard_status=$?
    if [ "$guard_status" -ne 0 ]; then
        echo "" >&2
        if [ "$guard_status" -eq 2 ]; then
            echo "main-tree-guard: UNDETERMINED (exit 2) — the gate could not reach a verdict." >&2
            echo "  This blocks. If the message names an unrecognized subcommand, the condukt" >&2
            echo "  binary predates this gate: cargo build --release -p condukt." >&2
        else
            echo "main-tree-guard: blocked (exit $guard_status)." >&2
        fi
        rc=1
    fi
fi

if [ "$rc" -ne 0 ]; then
    cat >&2 <<'EOF'

One or more local gates blocked this commit. A red gate is a detection, not an
obstacle — it found the defect at the cheapest possible moment.

Remediation hints:
  injectguard       remove the planted instruction, or frame legitimate
                    defensive text under a prompt-injection heading so the
                    scanner reads it as data rather than as an attack.
  fail-open-guard   fail CLOSED: for a read_dir walk use `match read_dir { Ok(e)
                    => e, Err(e) if e.kind() == NotFound => .., Err(e) =>
                    <surface> }` plus a per-entry `match entry {...}` (never
                    `.flatten()`); for a shell capture keep the rc (`... || rc=$?`)
                    and refuse to pass when it is non-zero.
  doc-claims        the cited `path:line` no longer says what the prose claims.
                    Fix the citation or the prose — in THIS commit, not later.
  claudemd-claims   same as doc-claims, scoped to CLAUDE.md itself. Fix the
                    citation or the code — there is no bypass flag for this
                    gate; a reasoned `<!-- doc-claim-exempt: <reason> -->` on
                    the line before a deliberately historical claim is the
                    only escape hatch.
  test-weakening    restore the assertion, or acknowledge one specific finding
                    with a commit-message line
                    `test-weakening-justified: <path>:<kind> - <reason>`.
  version-lockstep  bring Cargo.toml / .claude-plugin/plugin.json /
                    .claude-plugin/marketplace.json back into agreement.
  bump-on-change    you touched a plugin without raising its version; raise at
                    least the patch component in all three files.
  secret-guard      remove the literal value from the added line (use an env
                    var / secret-store reference instead), or, if it is a
                    reviewed exception, add a distinguishing substring to
                    scripts/check-hardcoded-secret.py's ALLOWLIST with a reason.
  raw-io-ratchet    a raw std::fs::read_dir/read_to_string or Command::new
                    call landed in a GATE_CRATES src/ tree. Route it through
                    harness_core::boundary's Determination-returning wrappers
                    instead of the raw stdlib call. If this is a reviewed,
                    intentional exception, re-pin with `python3
                    scripts/check-raw-io-ratchet.py --update-baseline` and
                    commit the updated scripts/check-raw-io-ratchet.baseline
                    (raising the pin is visible in review, not hidden).
  main-tree-guard   commit from a worktree instead of the shared primary tree
                    (`condukt worktree create`, or `git stash` + `git worktree
                    add`). Merges and rebases in the main tree already pass. If
                    you must commit here anyway, say why:
                    CONDUKT_MAINTREE_OVERRIDE="<reason>" git commit ... — the
                    reason is printed and the finding is not rewritten. It is an
                    environment variable, never a file, so it cannot leak into
                    another session's commit.

`git commit --no-verify` skips this hook — git offers no way to refuse that. It
is no longer silent, though: .githooks/post-commit records any commit whose tree
this hook never certified, `git push` is blocked while such a commit is
outstanding, and the record is cleared only by a run of this hook that goes
green — i.e. by the content actually being inspected.
EOF
    exit "$rc"
fi

# Green. Certify what was inspected so post-commit can tell a gated commit from
# a bypassed one. Per-worktree, so two worktrees committing at the same time
# cannot certify each other's trees.
#
# The certificate names the TREE *and* the HEAD it was judged against, not the
# tree alone. Two of the six gates read a diff rather than a snapshot
# (check-test-weakening and check-version-bumped both compare against HEAD), so
# their verdict is a property of the pair. A tree-only certificate would survive
# HEAD moving underneath it: run the gate green at HEAD=A, abandon the commit,
# pull so HEAD=B, then `git commit --no-verify` the identical tree — the tree
# still matches, so post-commit would call it gated, while the diff that was
# actually judged no longer exists. Binding HEAD in closes that.
#
# Cost of the stricter form, stated rather than discovered later: `git commit
# --amend` re-parents onto HEAD^, so the recorded HEAD is not among the new
# commit's parents and the amend is recorded as ungated. That is a false
# positive which fails CLOSED, and one green pre-commit clears it.
GIT_DIR_LOCAL="$(git rev-parse --git-dir 2>/dev/null)"
GIT_DIR_COMMON="$(git rev-parse --git-common-dir 2>/dev/null)"
if [ -n "${GIT_DIR_LOCAL:-}" ] && tree="$(git write-tree 2>/dev/null)"; then
    head="$(git rev-parse HEAD 2>/dev/null)" || head=""
    printf '%s %s\n' "$tree" "$head" > "$GIT_DIR_LOCAL/gate-verified-tree"
fi

# The gate just inspected this tree and found it clean, so any commit sitting in
# the bypass ledger is now covered. Clearing here — and NOWHERE else — keeps the
# clearing tied to an actual inspection: there is no command that just empties it.
LEDGER="${GIT_DIR_COMMON:-}/gate-bypassed"
if [ -n "${GIT_DIR_COMMON:-}" ] && [ -s "$LEDGER" ]; then
    cleared="$(wc -l < "$LEDGER" 2>/dev/null | tr -d ' ')"
    rm -f "$LEDGER"
    echo "pre-commit: gates green — cleared $cleared ungated commit(s) from the bypass ledger." >&2
fi

exit 0
