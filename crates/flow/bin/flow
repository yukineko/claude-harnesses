#!/bin/sh
# flow plugin launcher — selects the per-platform binary bundled in this dir.
#
# The SessionStart hook calls `${CLAUDE_PLUGIN_ROOT}/bin/flow propose`
# (hooks/hooks.json); `propose` is flow's ONLY subcommand.
#
# WHEN NO BUILD EXISTS FOR THE HOST, the answer is NOT "exit 0". `propose`
# injects a "/flow を開始しますか" proposal when the backlog has pending items
# and stays SILENT when the queue is empty (src/main.rs), so a silent exit 0 is
# byte-for-byte "the queue is empty". That is impact (b) of backlog item
# a33f644f: flow's Step 3-1 stop predicate reads "no pending tasks" as an empty
# queue and quietly ends the autonomous loop.
#
# The binary already distinguishes the third answer — `fallback_directive` is
# what it prints when the backlog binary itself is unavailable — so the launcher
# says the same thing about its own absence. SessionStart cannot block, so the
# restrictive resolution is to SPEAK (stdout is injected as context), never to
# stay silent (CLAUDE.md §1/§3).
root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *)      os="$(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64)   arch=x86_64 ;;
  arm64|aarch64)  arch=arm64 ;;
  *)              arch="$(uname -m)" ;;
esac

ext=""
[ "$os" = windows ] && ext=".exe"

binary="$root/flow-$os-$arch$ext"
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

echo "flow: no bundled binary for $os-$arch ($binary)." >&2

case "${1:-}" in
  propose)
    echo "flow propose did NOT run: no bundled binary for $os-$arch, so the backlog was NOT consulted. The absence of a /flow proposal here means UNKNOWN, not an empty queue — do not treat it as evidence that there is no pending work. Build it with scripts/build-plugin-bin.sh for $os-$arch, or remove the flow hook."
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
