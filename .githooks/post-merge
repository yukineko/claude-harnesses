#!/bin/sh
# The recorder for merge commits. post-commit does NOT run for a merge — git
# calls pre-merge-commit, commit-msg and post-merge instead:
#
#     merge --no-ff               pre-merge-commit, commit-msg, post-merge
#     merge --no-ff --no-verify   post-merge
#
# Without this hook, `git merge --no-verify` would be strictly worse than
# `git commit --no-verify`: ungated AND unrecorded, because the ledger's only
# writer never ran. post-merge is the one hook that survives the flag here.
#
# (An earlier reading of this table claimed post-commit ran on merges. It was
# contaminated — the probe's own setup commits had written to the same log. The
# table above comes from a probe whose log is reset immediately before the merge
# and is pinned by scripts/test_git_hook_coverage.py.)
#
# A fast-forward merge creates no commit, so there is nothing to certify and the
# absent sentinel must not be read as a bypass — that would fire on every
# `git pull`. Only a real merge commit (two or more parents) is handed on.

set -u

parents="$(git rev-parse HEAD^@ 2>/dev/null | grep -c .)" || exit 0
[ "${parents:-0}" -lt 2 ] && exit 0

exec "$(dirname "$0")/post-commit"
