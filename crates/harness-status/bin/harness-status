#!/bin/sh
# harness-status plugin launcher — selects the per-platform binary bundled here.
#
# The SessionStart hook calls `${CLAUDE_PLUGIN_ROOT}/bin/harness-status
# session-start` (hooks/hooks.json); the /status command calls the rest.
#
# WHEN NO BUILD EXISTS FOR THE HOST, the answer is NOT "exit 0" — and this
# launcher is the sharpest case in the repo, because `session-start` is the
# detector for exactly this class of defect: it emits `additionalContext` when a
# REGISTERED hook's binary is missing (src/main.rs:296-330). It speaks only when
# something is wrong, so a silent exit 0 is a clean bill of health — issued by a
# machine that is, by construction, missing at least one plugin binary (its own).
# CLAUDE.md §1/§3.
#
# Classification:
#
#   session-start  SessionStart -> additionalContext saying the hook-health scan
#                  and the PATH-shadow scan did NOT run. This mirrors the
#                  vocabulary the binary already uses for its own third answer
#                  ("PATH-shadow scan が完了しませんでした（判定不能）",
#                  src/main.rs:317-321). SessionStart cannot block, so speaking
#                  is the whole of the restrictive resolution.
#
#   budget / sessions / progress / hooks / inject / plugins / hooks-health /
#   path-shadow -> exit 1. These are read by the /status command and by humans,
#   and every one of them is a FINDING LIST whose emptiness reads as "nothing
#   wrong" — the same fail-open one level down (CLAUDE.md §3).
root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *)      os="$(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64)   arch=x86_64 ;;
  arm64|aarch64)  arch=arm64 ;;
  *)              arch="$(uname -m)" ;;
esac

ext=""
[ "$os" = windows ] && ext=".exe"

binary="$root/harness-status-$os-$arch$ext"
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

echo "harness-status: no bundled binary for $os-$arch ($binary)." >&2

case "${1:-}" in
  session-start)
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
      "harness-status session-start did NOT run: no bundled binary for $os-$arch. Neither the registered-hook binary health scan nor the PATH-shadow scan was performed, so the health of this harness install is UNKNOWN — the absence of a warning here is NOT a clean bill of health. Note that harness-status is itself a plugin whose binary is missing, so at least one registered hook binary IS absent. Run scripts/rollout-plugins.sh, or build it with scripts/build-plugin-bin.sh for $os-$arch."
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
