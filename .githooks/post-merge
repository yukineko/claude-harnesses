#!/bin/sh
# The recorder for merge commits. post-commit does NOT run for a merge — git
# calls pre-merge-commit, commit-msg and post-merge instead:
#
#     merge --no-ff               pre-merge-commit, commit-msg, post-merge
#     merge --no-ff --no-verify   post-merge
#
# Without this hook, `git merge --no-verify` would be strictly worse than
# `git commit --no-verify`: ungated AND unrecorded, because the ledger's only
# writer never ran. post-merge is the one hook that survives the flag here.
#
# (An earlier reading of this table claimed post-commit ran on merges. It was
# contaminated — the probe's own setup commits had written to the same log. The
# table above comes from a probe whose log is reset immediately before the merge
# and is pinned by scripts/test_git_hook_coverage.py.)
#
# A fast-forward merge creates no commit, so there is nothing to certify and the
# absent sentinel must not be read as a bypass — that would fire on every
# `git pull`. Only a merge commit that THIS merge created is handed on: HEAD
# must have two or more parents (below) AND the merge must not have been a
# fast-forward or a squash (further below — a fast-forward onto an existing
# merge commit also leaves a two-parent HEAD).

set -u

# --- version collision after ANY merge, fast-forward included ---------------
# Two lines of work can each bump a plugin to the SAME version with DIFFERENT
# content. Each commit passes check-version-bumped against its own parent, git
# merges the identical version lines without a conflict, and the result is a
# version that names two contents. A rollout at an unchanged version is a
# no-op, so whichever content was deployed first stays live (observed
# 2026-10-20: flow 0.2.26 from 48335620 deployed, then 994a8695's 0.2.26 with a
# different SKILL.md arrived by `git pull`). pre-merge-commit cannot see this:
# measured, MERGE_HEAD is not readable there, and a fast-forward runs no
# pre-* hook at all. Here both sides are known: ORIG_HEAD is what this checkout
# had (and may have deployed), and HEAD^2.. is what a merge made here took in.
#
# post-merge cannot undo the merge, so this REPORTS; it does not block. It runs
# before the merge-commit early exit below because a fast-forward needs it too.
# Undetermined (no ORIG_HEAD, no python3, the checker errors) is said aloud,
# never read as "no collision".
vb_report() {
  printf '\n%s\n' "POST-MERGE VERSION CHECK: $1" >&2
}
if [ "${1:-0}" != "1" ]; then
  vb_bases=""
  if vb_orig="$(git rev-parse -q --verify ORIG_HEAD 2>/dev/null)"; then
    vb_bases="$vb_orig"
  else
    vb_report "UNDETERMINED - ORIG_HEAD is not readable, so this merge was NOT checked for same-version content changes."
  fi
  vb_subj="$(git reflog -1 --format=%gs HEAD 2>/dev/null)" || vb_subj=""
  case "$vb_subj" in
    *": Fast-forward" | *": Fast-forward (no commit created; -m option ignored)") ;;
    *)
      for vb_p in $(git rev-parse HEAD^@ 2>/dev/null | sed 1d); do
        vb_bases="$vb_bases $vb_p"
      done ;;
  esac
  for vb_base in $vb_bases; do
    if ! command -v python3 >/dev/null 2>&1; then
      vb_report "UNDETERMINED - python3 not found; same-version content changes vs $vb_base were NOT checked."
      break
    fi
    python3 scripts/check-version-bumped.py --base "$vb_base" --head HEAD >/dev/null 2>"${TMPDIR:-/tmp}/post-merge-vb.$$"
    vb_rc=$?
    if [ "$vb_rc" -ne 0 ]; then
      if [ "$vb_rc" -eq 1 ]; then
        vb_report "VERSION COLLISION vs $vb_base - content changed under an unchanged version. A plain rollout will NOT deploy it; bump the version (>= micro, lockstep) in a worktree before rolling out."
      else
        vb_report "UNDETERMINED (checker exit $vb_rc) vs $vb_base - NOT a pass."
      fi
      cat "${TMPDIR:-/tmp}/post-merge-vb.$$" >&2
    fi
    rm -f "${TMPDIR:-/tmp}/post-merge-vb.$$"
  done
fi

parents="$(git rev-parse HEAD^@ 2>/dev/null | grep -c .)" || exit 0
[ "${parents:-0}" -lt 2 ] && exit 0

# Advisory, fail-soft spec-map refresh. specguard's spec-map
# (.specguard/spec-map.toml) only stays accurate if `map sync` runs after each
# merge (crates/specguard/README.ja.md "spec-map を新鮮に保つ"); this repo
# left that opt-in cron/hook fragment uncopied, so the map (and anything that
# scores candidates against it, e.g. scout Phase 3) silently went stale as
# tests/impl changed. This step is best-effort and never affects this hook's
# exit code or the exec below — a failed/absent sync just leaves the map
# stale until the next merge or a manual `specguard map sync`.
if command -v specguard >/dev/null 2>&1; then
  mkdir -p "$HOME/.specguard" 2>/dev/null || true
  specguard map sync >>"$HOME/.specguard/map-sync.log" 2>&1 || true
fi

# Was HEAD CREATED by this merge, or did the merge merely move HEAD onto a
# merge commit that already existed? The parent count above cannot tell:
# fast-forwarding onto a merge commit leaves HEAD with two parents exactly like
# a fresh merge does. Handing that on recorded the existing commit as ungated
# — a commit this merge never created and which, when it was created, went
# through pre-merge-commit green — and every further fast-forward onto it (each
# worktree catching up to main) appended it again (backlog 1d2446de, measured:
# one gated merge, two ledger entries, push blocked).
#
#   --squash ($1 = 1)  creates no commit at all; HEAD is whatever it was before,
#                      possibly an earlier merge. Nothing to record.
#   fast-forward       git writes the HEAD reflog entry "<action>: Fast-forward"
#                      (plus " (no commit created; -m option ignored)" with -m).
#                      A merge that creates a commit writes "<action>: Merge
#                      made by the '<strategy>' strategy." (or, for -s resolve,
#                      "<action>: In-index merge") instead. Only <action> is
#                      user-controlled (GIT_REFLOG_ACTION), so the patterns are
#                      anchored on the fixed SUFFIX: a prefix of "x: Fast-forward"
#                      on a real merge still ends in "...strategy.". The entry
#                      is honoured only when it is about the current HEAD.
#
# Scope, stated: a merge commit created in ANOTHER clone and fast-forwarded in
# here is not recorded (the old parent-count check recorded it only by
# accident; a fetched single-parent commit was never recorded either).
#
# Only a POSITIVE fast-forward/squash observation skips the recorder. Anything
# else — a merge-made entry, no reflog at all (core.logAllRefUpdates=false),
# an unreadable reflog, an entry for some other HEAD — falls through to
# post-commit, which records the commit unless pre-merge-commit certified it.
# Cannot determine is a record, never a pass (CLAUDE.md 3.); the worst case is a
# false positive that a green pre-commit clears.
[ "${1:-0}" = "1" ] && exit 0

head_sha="$(git rev-parse HEAD 2>/dev/null)" || head_sha=""
reflog_sha="$(git reflog -1 --format=%H HEAD 2>/dev/null)" || reflog_sha=""
reflog_subject="$(git reflog -1 --format=%gs HEAD 2>/dev/null)" || reflog_subject=""
if [ -n "$head_sha" ] && [ "$reflog_sha" = "$head_sha" ]; then
  case "$reflog_subject" in
    *": Fast-forward" | *": Fast-forward (no commit created; -m option ignored)")
      exit 0 ;;
  esac
fi

exec "$(dirname "$0")/post-commit"
