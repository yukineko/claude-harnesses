// Generated by `overwatch ask-learn file-reds` (learned Allow promotion).
// The shape below was approved enough times that blastguard learned to Allow it;
// this RED asks for the PERMANENT rule: the samples must be Allow with NO learned
// table. Remove the #[ignore] when the rule fix lands.
#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
use std::io::Write as _;
use std::process::{Command, Stdio};

const SAMPLES: &[&str] = &[
@LIST@];

#[test]
#[ignore = "RED(learned @KEY@): promote this shape to a permanent rule"]
fn learned_shape_samples_are_allow_without_the_table() {
    let root = std::env::temp_dir().join(format!("bg-learned-shape-{}", std::process::id()));
    let _ = std::fs::remove_dir_all(&root);
    std::fs::create_dir_all(root.join("home")).unwrap();
    let table = root.join("empty-table.json");
    std::fs::write(&table, r#"{"version":1,"entries":[]}"#).unwrap();
    for cmd in SAMPLES {
        let payload = serde_json::json!({
            "hook_event_name": "PreToolUse",
            "session_id": "7a1e0c55-0000-4d2e-9f00-000000000000",
            "cwd": root.to_str().unwrap(),
            "tool_name": "Bash",
            "tool_input": { "command": cmd },
        });
        let mut c = Command::new(env!("CARGO_BIN_EXE_blastguard"));
        c.env("HOME", root.join("home"))
            .env("BLASTGUARD_BLOCK_LOG_DIR", root.join("blocklog"))
            .env("BLASTGUARD_RELAY_DIR", root.join("relay"))
            .env("BLASTGUARD_APPROVALS_DIR", root.join("approvals"))
            .env("BLASTGUARD_LEARNED_TABLE", &table)
            .env_remove("CLAUDE_CODE_SESSION_ID")
            .env_remove("BLASTGUARD_ASK")
            .env_remove("CLAUDE_PROJECT_DIR")
            .env("CLAUDECODE", "1")
            .env("CLAUDE_CODE_ENTRYPOINT", "cli")
            .stdin(Stdio::piped())
            .stdout(Stdio::piped())
            .stderr(Stdio::piped());
        let mut child = c.spawn().unwrap();
        child.stdin.take().unwrap().write_all(payload.to_string().as_bytes()).unwrap();
        let out = child.wait_with_output().unwrap();
        let stdout = String::from_utf8_lossy(&out.stdout);
        assert!(stdout.trim().is_empty(), "{cmd:?} is not Allow without the learned table: {stdout}");
    }
}
