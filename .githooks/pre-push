#!/bin/sh
# Versioned pre-push hook. Enable once per clone with:
#
#     git config core.hooksPath .githooks
#
# This hook has three advisory nudges plus six blocking checks (the bypass
# ledger below, `cargo check` over the crates each pushed range touches, the
# trybuild compile-fail type contracts via scripts/check-compile-fail.py,
# `specguard map gate-check` over each pushed range, the fail-open mutation
# harness (scripts/check-fail-open-mutation.py) over the gate crates each
# pushed range touches, and a final re-check that
# each pushed ref still names the sha those checks judged — see the end of this
# file; over https that re-check narrows but does not close the window, a
# residual window remains). Every check is scoped to THIS push's range, runs
# from THIS worktree only (no git worktree or second checkout is created, and no
# other worktree is consulted), and a check already recorded as passed for the
# exact pushed tree is not rerun (scripts/test-pass-record.py; user ruling
# 2026-11-08). One exception to "the check runs in this tree": the fail-open
# mutation harness (check 5) copies this tree into a scratch temporary
# directory and mutates and tests that copy, so this tree is never written
# (user ruling 2026-11-14, which reads the 2026-11-08 "no temp checkout" as "no
# git worktree / second checkout"):
#   1. GATE crates (advisory) — when the push touches blastguard/propguard/
#      specguard/stuckguard/mutategate/overwatch (the fleet defense gates),
#      suggest a Continuous-Audit round (`scripts/continuous-audit.sh --dry-run`).
#   2. Rollout drift — `scripts/check-plugin-rollout.py` reports plugins whose
#      committed+bumped version was never actually rolled out to the live plugin
#      cache. That fix then reaches NO session. This has to live here rather than
#      in CI: the check reads ~/.claude/plugins/installed_plugins.json, which is
#      a property of the developer's machine and does not exist on a runner.
#      ALL of its sub-classes are advisory. rc=1 ("committed but not rolled
#      out") used to BLOCK (2026-07-22: 16 plugins drifted silently across ~20
#      commits in one session before anyone ran the checker by hand). It was
#      demoted on 2026-07-23 because it gates the wrong thing at the wrong
#      point: drift is a property of THIS machine's plugin cache, while `git
#      push` shares CODE with a remote — local deployment state is not a
#      statement about code quality, so it must not decide whether good commits
#      may leave this machine. The detection is unchanged; only the consequence
#      moved. See the rc=1 branch for the full argument, and the backlog item
#      for relocating enforcement to session start (where an operator can act on
#      it) so this does not degrade into "someone will notice". rc=2
#      (enablement) and rc=3 (unverifiable) were already advisory: neither has a
#      rollout fix, so blocking on them would send the reader to a command that
#      cannot help.
#   3. Autonomy chain (advisory) — when the push touches the crates whose SKILL
#      specs the human-0 chain depends on (condukt/scout/flow/backlog), suggest
#      re-running `scripts/e2e-autonomy.sh`, which asserts the gate contracts
#      that remove every AskUserQuestion stop. Also machine-local (needs
#      installed binaries).
#
# Checks 1, 3, and rollout-drift's sub-classes are advisory and always
# degrade to silence when their prerequisite (python3, the script, the registry)
# is absent. They never block.
#
# The FIRST of the six blocking checks: the first thing this hook does is look
# for an ungated commit outstanding in the bypass ledger (`scripts/gate-bypass.py`). That is the
# consequence half of closing the `--no-verify` hole — the bypass cannot be
# prevented at commit time, so it is instead made to stop the next push until the
# content has actually been through the gate.
#
# A chronically-red-CI check used to block here too (it shelled out to
# `scripts/check-ci-red.py`, which queried GitHub Actions). It was REMOVED:
# GitHub Actions is banned in this repo (CLAUDE.md — never used, no exceptions),
# so a push-gate predicated on GHA workflow state has no state to read, and per
# CLAUDE.md section 7 the authority to stop or pass a push must never be held by
# an external service in the first place. Enforcement lives in the local
# pre-commit gate, not in CI.
#
# Every phase is timed (observability only, no verdict): see "phase timing"
# just below `set -u`.
#
# Formalizes the pre-push fragment sketched in
# scripts/continuous-audit.cron.example into a real, installable hook.
#
# Manual test (no real push needed):
#   printf 'refs/heads/main %s refs/heads/main %s\n' "$(git rev-parse HEAD)" "$(git rev-parse HEAD~1)" \
#     | bash .githooks/pre-push origin https://example.invalid/repo.git

set -u

# --- phase timing (observability only) ---------------------------------------
# Records how long each phase takes, so a slow push can be attributed to a
# phase (a ~7.5 min push once could not be). Wall-clock seconds via `date +%s`.
# Printed as one summary line on stderr at EXIT (also when a phase blocks, so a
# block still reports what was measured up to that point) and appended as one
# JSON line to "$(git rev-parse --git-common-dir)/prepush-timing.jsonl".
#
# NOT A VERDICT. Downstream consumers: a human reading the stderr line, and a
# human (or ad-hoc jq) reading the jsonl log when diagnosing a slow push. No
# gate, script or check reads either one, so nothing here decides anything: it
# must never change a block/allow decision, the exit code, or the phase order.
# The EXIT trap re-exits with the status it was entered with; a log that cannot
# be written produces a one-line warning and nothing else. If that log ever
# becomes the input of another check, this exemption lapses (CLAUDE.md 1).
#
# Lock-wait is NOT recorded: every cargo call here runs with --quiet (or inside
# check-compile-fail.py, which captures cargo's stderr and shows it only on
# failure), and cargo's "Blocking waiting for file lock" is a shell status line
# that --quiet suppresses (cargo src/util/flock.rs status_with_color("Blocking",
# ...); crates/cargo-util-terminal/src/shell.rs print(): Verbosity::Quiet =>
# Ok(())). Capturing it would mean dropping --quiet, which changes what the
# user sees, so it is skipped.
_tm_now() {
    _tm_v="$(date +%s 2>/dev/null)"
    case "$_tm_v" in ''|*[!0-9]*) _tm_v="" ;; esac
}
_tm_now; _tm_total_t0="$_tm_v"
_tm_start_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
_tm_name=""; _tm_sha=""; _tm_t0=""
_tm_sum=""; _tm_json=""
_tm_extra_sum=""; _tm_extra_json=""; _tm_extra_field=""
timing_shas=""
# _tm_secs <t0>: elapsed seconds since t0 into _tm_s ("" when unknown).
_tm_secs() {
    _tm_now
    if [ -n "$1" ] && [ -n "$_tm_v" ]; then _tm_s=$((_tm_v - $1)); else _tm_s=""; fi
}
# Builtins only (no tr/cut): values that are not plain hex / plain target
# labels are replaced, so nothing unescaped ever reaches the JSON line.
_tm_hexonly() {
    case "$1" in ''|*[!0-9a-fA-F]*) printf 'invalid' ;; *) printf '%s' "$1" ;; esac
}
_tm_labelonly() {
    case "$1" in ''|*[!A-Za-z0-9_:.-]*) printf 'invalid' ;; *) printf '%s' "$1" ;; esac
}
phase_begin() {
    _tm_name="$1"; _tm_sha="${2:-}"
    _tm_extra_sum=""; _tm_extra_json=""; _tm_extra_field=""
    _tm_now; _tm_t0="$_tm_v"
}
phase_end() {
    [ -n "$_tm_name" ] || return 0
    _tm_secs "$_tm_t0"
    _tm_label="$_tm_name"
    _tm_entry="{\"phase\":\"$_tm_name\""
    if [ -n "$_tm_sha" ]; then
        _tm_hex="$(_tm_hexonly "$_tm_sha")"
        _tm_label="$_tm_name(${_tm_hex%"${_tm_hex#????????}"})"
        _tm_entry="$_tm_entry,\"sha\":\"$_tm_hex\""
    fi
    _tm_entry="$_tm_entry,\"secs\":${_tm_s:-null}"
    [ -n "$_tm_extra_json" ] && _tm_entry="$_tm_entry,\"targets\":{$_tm_extra_json}"
    _tm_entry="$_tm_entry$_tm_extra_field}"
    _tm_label="$_tm_label ${_tm_s:-?}s"
    [ -n "$_tm_extra_sum" ] && _tm_label="$_tm_label [$_tm_extra_sum]"
    _tm_sum="${_tm_sum:+$_tm_sum, }$_tm_label"
    _tm_json="${_tm_json:+$_tm_json,}$_tm_entry"
    _tm_name=""; _tm_sha=""; _tm_extra_sum=""; _tm_extra_json=""; _tm_extra_field=""
}
# Pass-through filter for check-compile-fail.py's stderr: every line is
# re-emitted unchanged to stdout, and each "running <target> ..." line opens a
# per-target timer closed by the next ok/FAILED/UNDETERMINED line (or EOF).
# Per-target results go to fd 3 as "T <target> <secs>"; a target the script
# skipped from its pass cache ("skipped <target> (...)") goes as "S <target>".
_cf_emit() {
    _tm_secs "$_cf_t0"
    printf 'T %s %s\n' "$(_tm_labelonly "$_cf_label")" "${_tm_s:-?}" >&3
    _cf_label=""
}
prepush_cf_filter() {
    _cf_label=""; _cf_t0=""; _cf_l=""
    while IFS= read -r _cf_l || [ -n "$_cf_l" ]; do
        printf '%s\n' "$_cf_l"
        case "$_cf_l" in
            "check-compile-fail: running "*)
                [ -n "$_cf_label" ] && _cf_emit
                _cf_label="${_cf_l#check-compile-fail: running }"
                _cf_label="${_cf_label% ...}"
                _tm_now; _cf_t0="$_tm_v" ;;
            "check-compile-fail: skipped "*)
                [ -n "$_cf_label" ] && _cf_emit
                _cf_sk="${_cf_l#check-compile-fail: skipped }"
                printf 'S %s\n' "$(_tm_labelonly "${_cf_sk%% (*}")" >&3 ;;
            "check-compile-fail: ok "*|"check-compile-fail: FAILED "*|"check-compile-fail: UNDETERMINED"*)
                [ -n "$_cf_label" ] && _cf_emit ;;
        esac
        _cf_l=""
    done
    [ -n "$_cf_label" ] && _cf_emit
    return 0
}
prepush_timing_report() {
    phase_end
    _tm_secs "$_tm_total_t0"
    _tm_total="$_tm_s"
    echo "pre-push timing: ${_tm_sum:-(no phase reached)}; total ${_tm_total:-?}s (exit $1)" >&2
    _tm_shas=""
    for _tm_x in ${timing_shas:-${pushed_shas:-}}; do
        _tm_x="$(_tm_hexonly "$_tm_x")"
        _tm_shas="${_tm_shas:+$_tm_shas,}\"$_tm_x\""
    done
    _tm_line="{\"start\":\"$_tm_start_iso\",\"shas\":[$_tm_shas],\"phases\":[$_tm_json],\"total\":${_tm_total:-null},\"exit\":$1}"
    _tm_dir="$(git rev-parse --git-common-dir 2>/dev/null)"
    case "$_tm_dir" in
        "" | /*) ;;
        *) _tm_dir="$(cd "$_tm_dir" 2>/dev/null && pwd)" ;;
    esac
    if [ -z "$_tm_dir" ] || ! { printf '%s\n' "$_tm_line" >>"$_tm_dir/prepush-timing.jsonl"; } 2>/dev/null; then
        echo "pre-push timing: could not append to ${_tm_dir:-<git common dir>}/prepush-timing.jsonl (timing not logged; the push decision is unaffected)" >&2
    fi
}
prepush_on_exit() {
    _tm_rc=$?
    cleanup_specmap
    prepush_timing_report "$_tm_rc"
    exit "$_tm_rc"
}
# The specguard gate-check builds its spec map in a temp dir (never the
# worktree's own machine-local map); this removes that dir. Nothing else here
# creates files outside the git common dir.
SPECMAP_TMP=""
cleanup_specmap() {
    if [ -n "${SPECMAP_TMP:-}" ] && [ -d "$SPECMAP_TMP" ]; then
        rm -f "$SPECMAP_TMP/spec-map.toml"
        rmdir "$SPECMAP_TMP" 2>/dev/null
    fi
    return 0
}
trap prepush_on_exit EXIT

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "pre-push: cwd is not inside any git work tree - refusing to certify this push" >&2; exit 1; }
cd "$REPO" 2>/dev/null || { echo "pre-push: cannot enter the repository work tree root - refusing to certify this push" >&2; exit 1; }

# --- the first blocking check: the bypass ledger -----------------------------
# An ungated commit (created with --no-verify, or replayed by cherry-pick or
# rebase) must not leave this machine before the gate has seen its content.
# exit 1 = outstanding, exit 2 = the ledger could not be read; both block, since
# "could not determine" is not "clean". A missing python3 or missing script also
# blocks: this check has teeth or it is theatre.
#
# Each pushed (local sha, remote sha) pair is passed as --push, so only ledger
# entries THIS push carries (reachable from the local sha, not from the remote
# sha) block it; an ungated commit on some other branch does not (user ruling
# 2026-10-22). That also keeps `git push origin <sha>:main` of an orphaned
# ungated commit blocked. An undeterminable range exits 2 and blocks.
#
# Only THIS push's range is judged (user ruling 2026-11-08: no other-worktree
# scan). With no stdin lines at all (a manual run) the range is @{push}..HEAD:
# HEAD over the @{push} sha, or over nothing (every ancestor of HEAD counts as
# carried, the restrictive side) when @{push} does not resolve. With only delete
# lines, no commit is carried, so there is nothing for the ledger to judge.
PUSH_INPUT="$(cat)"
set --
_saw_line=0
while read -r _lr _ls _rr _rs; do
    [ -n "${_ls:-}" ] && _saw_line=1
    case "${_ls:-}" in
        ""|0000000000000000000000000000000000000000) ;;
        *) set -- "$@" --push "$_ls" "${_rs:-0000000000000000000000000000000000000000}"
           timing_shas="$timing_shas $_ls" ;;
    esac
done <<EOF
$PUSH_INPUT
EOF
ledger_skip=0
if [ "$#" -eq 0 ]; then
    if [ "$_saw_line" -eq 1 ]; then
        ledger_skip=1
    else
        _manual_head="$(git rev-parse --verify --quiet HEAD 2>/dev/null)"
        if [ -z "$_manual_head" ]; then
            echo "pre-push: no ref lines on stdin and no resolvable HEAD — nothing determinate to judge, so blocking." >&2
            exit 1
        fi
        _manual_base="$(git rev-parse --verify --quiet '@{push}' 2>/dev/null)"
        set -- --push "$_manual_head" "${_manual_base:-0000000000000000000000000000000000000000}"
    fi
fi
phase_begin bypass-ledger
if [ "$ledger_skip" -eq 1 ]; then
    : # delete-only push: no commit leaves this machine
elif command -v python3 >/dev/null 2>&1 && [ -f "$REPO/scripts/gate-bypass.py" ]; then
    python3 "$REPO/scripts/gate-bypass.py" "$@" >/dev/null
    bypass_rc=$?
    if [ "$bypass_rc" -ne 0 ]; then
        python3 "$REPO/scripts/gate-bypass.py" "$@" >&2
        echo "" >&2
        echo "pre-push: blocked. Push again once the gate has gone green over this" >&2
        echo "content — a successful pre-commit over a non-empty staged diff clears" >&2
        echo "the entries whose commit is an ancestor of that HEAD." >&2
        exit 1
    fi
else
    echo "" >&2
    echo "pre-push: cannot check for ungated commits (python3 or" >&2
    echo "scripts/gate-bypass.py missing) — blocking rather than assuming clean." >&2
    exit 1
fi
phase_end

phase_begin nudges
GATE_PATTERN='^crates/(blastguard|propguard|specguard|stuckguard|mutategate|overwatch|parallelguard)/'

# Crates whose SKILL specs carry the autonomy gate contracts asserted by
# scripts/e2e-autonomy.sh (scout selection/hand-off, condukt agreement, flow
# human gates). Deliberately NOT parsed by check-gate-crates-sync.py — this is
# the autonomy chain, a different set from the defense-gate GATE_CRATES above.
AUTONOMY_PATTERN='^crates/(condukt|scout|flow|backlog)/'

# git invokes pre-push with zero-or-more "<local-ref> <local-sha> <remote-ref> <remote-sha>"
# lines on stdin, one per updated ref. Collect the set of changed files across
# all pushed ranges. If stdin gives us nothing usable (e.g. manual invocation
# without piped refs), fall back to the @{push}..HEAD range, and finally to
# just-in-case skip (never fail the push over inability to compute a diff).
changed=""
saw_ref=0
# The tips actually being pushed. Collected here because the type check below
# must judge WHAT IS BEING PUSHED, not whatever happens to be on disk.
pushed_shas=""
# "<sha>:<base>" per pushed ref. The gate spec-doc check at the end needs the
# RANGE, not just the tip, and it must be the same range this loop diffed —
# otherwise the two halves of the hook would be answering about different
# content. git's empty-tree object is the determinate base for a root commit.
pushed_pairs=""
# "<sha>:<remote sha>" per pushed ref, or "<sha>:-" when the remote tip is not
# known here. The type/test checks below derive their crate scope from it.
pushed_remotes=""
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    saw_ref=1
    # Deleting a ref (local_sha all zeros) has nothing to diff.
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    pushed_shas="$pushed_shas $local_sha"
    has_remote=0
    if [ -n "${remote_sha:-}" ]; then
        case "$remote_sha" in
            0000000000000000000000000000000000000000) has_remote=0 ;;
            *) git cat-file -e "$remote_sha" 2>/dev/null && has_remote=1 ;;
        esac
    fi
    if [ "$has_remote" = "1" ]; then
        push_base="$remote_sha"
        diff_out="$(git diff --name-only "$remote_sha..$local_sha" -- 2>/dev/null)"
    else
        # No known remote tip (new branch / new ref) — diff against the
        # local sha's parents isn't well-defined generically, so list files
        # touched by the tip commit as a best-effort signal.
        push_base="$(git rev-parse --verify --quiet "${local_sha}^" 2>/dev/null)"
        [ -n "$push_base" ] || push_base="$EMPTY_TREE"
        diff_out="$(git show --name-only --pretty=format: "$local_sha" 2>/dev/null)"
    fi
    pushed_pairs="$pushed_pairs $local_sha:$push_base"
    if [ "$has_remote" = "1" ]; then
        pushed_remotes="$pushed_remotes $local_sha:$remote_sha"
    else
        pushed_remotes="$pushed_remotes $local_sha:-"
    fi
    changed="$changed
$diff_out"
done <<EOF
$PUSH_INPUT
EOF

if [ "$saw_ref" = "0" ]; then
    # No ref-update lines were readable from stdin at all (likely a manual/
    # non-standard invocation, not a real git-invoked pre-push) — fall back
    # to the range since the upstream tracking branch as a best-effort check.
    changed="$(git diff --name-only '@{push}..HEAD' 2>/dev/null || true)"
fi

if printf '%s\n' "$changed" | grep -Eq "$GATE_PATTERN"; then
    cat >&2 <<'EOF'

continuous-audit: gate-crate changes detected in this push (blastguard/
propguard/specguard/stuckguard/mutategate/overwatch). Consider running a
Continuous-Audit round before or after pushing:

    scripts/continuous-audit.sh --dry-run

This is advisory only — the push is not blocked.
EOF
fi

if printf '%s\n' "$changed" | grep -Eq "$AUTONOMY_PATTERN"; then
    cat >&2 <<'EOF'

e2e-autonomy: changes detected under a crate the human-0 chain depends on
(condukt/scout/flow/backlog). The autonomy gate contracts are asserted by:

    scripts/e2e-autonomy.sh

It re-checks the deterministic layer only (autonomy switch + gate contracts +
queue wiring), skips loudly if autonomy is off, and touches no real state.
This is advisory only — the push is not blocked.
EOF
fi
phase_end

# Rollout drift: a committed + version-bumped plugin whose fix was never rolled
# out to the live cache reaches no session at all. The checker exits 0 when the
# registry is absent (e.g. a machine with no plugins installed), so this stays
# quiet where it does not apply. Skipped entirely without python3 or the script.
#
# The checker distinguishes its failure CLASSES by exit code (rc=1 rollout
# drift, rc=2 enablement) because they have OPPOSITE fixes. Branching on a bare
# non-zero and then unconditionally printing the rollout prose told the reader
# to run `scripts/rollout-plugins.sh` for a disabled-GATE-crate failure — the
# one command that, by the checker's own hint, does NOT enable plugins. So: the
# checker's own output (which already carries the right Fix line for whichever
# class fired) is always echoed, and the extra rollout prose is added only for
# the rollout class. Any other non-zero rc is unrecognized: echo and say so
# rather than inventing a remediation for it.
#
# rc=1 (rollout drift proper) is ADVISORY (demoted 2026-07-23): rollout is a
# fact about THIS machine's plugin cache, and `git push` shares code with a
# remote, so local deployment state must not gate the share. rc=2/rc=3 stay
# advisory too (neither has a rollout remedy).
if command -v python3 >/dev/null 2>&1 && [ -f scripts/check-plugin-rollout.py ]; then
    phase_begin rollout
    rollout_out="$(python3 scripts/check-plugin-rollout.py 2>&1)"
    rollout_rc=$?
    if [ "$rollout_rc" -ne 0 ]; then
        printf '\n%s\n' "$rollout_out" >&2
    fi
    case "$rollout_rc" in
        0) ;;
        1)
            # DEMOTED TO ADVISORY (2026-07-23), deliberately — not because it was
            # noisy, but because it was gating the wrong thing at the wrong point.
            #
            # Rollout drift is a fact about THIS MACHINE's plugin cache
            # (`~/.claude/plugins/.../installed_plugins.json`): the committed code
            # is fine, it just has not been copied into the live harness here.
            # `git push` is the act of SHARING CODE with a remote. Local
            # deployment state says nothing about whether that code is correct,
            # so blocking the share on it conflated two unrelated concerns — and
            # penalized a machine that is behind on deployment by cutting it off
            # from publishing perfectly good commits.
            #
            # This is NOT "the gate went red so we silenced it" (CLAUDE.md §4).
            # The detection is unchanged and still runs and still prints; only
            # the *consequence* moved. The failure mode it was built for — a
            # committed, version-bumped fix that reaches no session (once found
            # by hand across 5 plugins) — is real and must stay covered, but it
            # is a DEPLOYMENT reminder, so it belongs at session start where the
            # operator can act on it, not on the push path.
            #
            # Backlog tracks relocating the enforcement so this does not degrade
            # into "someone will notice" (CLAUDE.md §6 forbids resting on that).
            #
            # An ORPHAN-ONLY rc=1 (an ORPHAN CACHE DIR block and no ROLLOUT
            # DRIFT block) has no crate to roll out; the checker's own Fix line
            # says so, and naming rollout-plugins.sh here would contradict it
            # (backlog d38c195b).
            case "$rollout_out" in
                *"ROLLOUT DRIFT ("*) rollout_orphan_only=0 ;;
                *"ORPHAN CACHE DIR ("*) rollout_orphan_only=1 ;;
                *) rollout_orphan_only=0 ;;
            esac
            if [ "$rollout_orphan_only" -eq 1 ]; then
                cat >&2 <<'EOF'

rollout: the plugin cache holds a dir for a plugin with no crate (ORPHAN CACHE
DIR above). That is NOT fixed by a rollout — follow the checker's Fix line
(delete the orphan cache dir, or declare it in scripts/retired-plugins.json).

This is advisory only — the push is not blocked.
EOF
            else
            cat >&2 <<'EOF'

rollout: the versions above are committed but not live on THIS machine — the fix
is in git and reaches no session here until you roll it out:

    scripts/rollout-plugins.sh --plugin <name>            # add --canary for GATE crates

This is advisory only — the push is not blocked. Rollout is local deployment
state, not code quality, so it does not gate sharing code with the remote.
EOF
            fi
            ;;
        3)
            # Unverifiable class. Neither a rollout nor an enablement edit can
            # fix it: the checker could not read a plugin.json at all, so the
            # population it inspected is incomplete and NOTHING it reported is a
            # complete verdict. Naming either remedy here would send the reader
            # to a command that cannot help — and, worse, imply the rest of the
            # report was verified when it was not.
            cat >&2 <<'EOF'

unverifiable: a crate under crates/ ships a plugin.json that could not be read
or parsed, so the rollout and enablement checks above covered an INCOMPLETE set
of plugins. Treat their result as unknown, not as a pass — fix the file named in
the Fix line above and re-run.

This is advisory only — the push is not blocked.
EOF
            ;;
        2)
            # Enablement class. Deliberately does NOT mention rollout-plugins.sh:
            # the checker's own Fix line above names the real remedy (edit
            # enabledPlugins in settings.json, then restart Claude Code).
            cat >&2 <<'EOF'

enablement: see the Fix line above — this class is NOT fixed by a rollout.
A GATE crate that is installed but not listed in enabledPlugins is inert: its
hooks never fire, so the gate reports nothing and guards nothing.

This is advisory only — the push is not blocked.
EOF
            ;;
        4)
            # Parked-declaration class. scripts/parked-plugins.json is what says
            # which of the reds above are intentional; while it is unusable, that
            # question has no answer, and the wrong guess is the expensive one —
            # arming a plugin that was parked on purpose is what caused the
            # 2026-08-04 incident (backlog a6f165cd).
            cat >&2 <<'EOF'

parked declaration: scripts/parked-plugins.json could not be used, so NONE of the
reds above were treated as intentional. Do not act on them until that file parses
— repair it (or delete it, which means nothing is parked) and re-run.

This is advisory only — the push is not blocked.
EOF
            ;;
        *)
            printf '\n%s\n' "rollout check: unrecognized exit code $rollout_rc — see its output above. This is advisory only; the push is not blocked." >&2
            ;;
    esac
    phase_end
fi

# --- blocking checks 2-4: compiler, trybuild contracts, gate spec-docs -------
# The one surface `--no-verify` cannot jump is the compiler. donegate runs cargo
# too, but as a Stop hook bounded by max_attempts and armed only on trusted
# roots, so it is not an enforcement surface on the mandated fresh-worktree path.
#
# SCOPE (user ruling 2026-11-08): only THIS push's range, never another
# worktree, never a whole-workspace sweep the range does not call for, and never
# a rerun of a check already confirmed for the same content.
#   * Range: REMOTE..S when the remote tip is known here, else the commits of S
#     on no remote-tracking ref (`git log S --not --remotes`). A range git cannot
#     compute widens to the whole workspace (the restrictive side).
#   * cargo check --all-targets runs for the crates/<dir> the range touches; a
#     root Cargo.toml / Cargo.lock / rust-toolchain(.toml) / .cargo change, or a
#     touched crates/<dir> with no Cargo.toml at S, widens it to --workspace. A
#     breakage this introduces in a crate OUTSIDE the range (a dependent of a
#     changed crate) is not caught here: that coverage was dropped
#     deliberately (user ruling 2026-11-08; the periodic audit runs only the
#     gate tests on main, not a workspace check).
#   * Then each touched crates/<dir> is also checked ALONE (`cargo check
#     --all-targets -p <crate>`), in the wide and the narrow path alike: a
#     multi-package check unifies dependency features across the packages, which
#     hides a crate whose own manifest lacks a feature its tests need (#1641).
#     An uncomputable range checks every workspace member alone.
#   * Dedupe: each check has a test id; before running it the hook asks
#     scripts/test-pass-record.py whether that id already passed for the EXACT
#     tree of S. Only an exit 0 skips; a missing, unreadable, corrupt or
#     mismatched record runs the check. A pass is recorded for that tree.
#   * In place: a check that must run runs in THIS worktree (cwd = repo root,
#     cargo's own target dir), and only when HEAD == S, the tree and index equal
#     HEAD, and nothing untracked sits under crates/ or the root cargo files —
#     so the content judged is exactly the content pushed. Anything else BLOCKS:
#     a verdict about the files on disk is not a verdict about S. Exception
#     (user ruling 2026-11-14): check 5, the fail-open mutation, copies this
#     verified tree into a scratch temporary directory and runs there (cwd =
#     the copy, CARGO_TARGET_DIR inside the copy). The same in-place
#     preconditions still gate it, so the copy holds exactly the content
#     pushed, and this tree is never written.
#
# FAIL-CLOSED throughout: no cargo when a check must run, an unresolvable tree,
# unreadable cargo metadata, a crate dir that maps to no package => block.

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

RECORD="$REPO/scripts/test-pass-record.py"

# No ref-update lines arrived (manual invocation) — fall back to HEAD over
# @{push}, which is still a determinate range. Never fall back to "skip".
if [ -z "${pushed_shas:-}" ] && [ "$saw_ref" = "0" ]; then
    pushed_shas="$(git rev-parse --verify --quiet HEAD 2>/dev/null)"
    if [ -z "$pushed_shas" ]; then
        echo "" >&2
        echo "pre-push: no pushed ref and no resolvable HEAD — nothing determinate to" >&2
        echo "type-check, so blocking rather than reporting a pass." >&2
        exit 1
    fi
    _mb="$(git rev-parse --verify --quiet '@{push}' 2>/dev/null)"
    pushed_remotes="$pushed_shas:${_mb:--}"
fi

# in_place_ok <sha>: 0 when this worktree's checkout IS <sha>, clean. Sets
# in_place_reason otherwise. Any git failure is "not ok" (the restrictive side).
in_place_reason=""
in_place_ok() {
    _ip_head="$(git rev-parse --verify --quiet HEAD 2>/dev/null)"
    if [ "$_ip_head" != "$1" ]; then
        in_place_reason="HEAD is ${_ip_head:-unresolvable}, not the pushed commit"
        return 1
    fi
    git diff --quiet HEAD -- 2>/dev/null
    _ip_rc=$?
    if [ "$_ip_rc" -eq 1 ]; then
        in_place_reason="the working tree or index differs from HEAD"
        return 1
    elif [ "$_ip_rc" -ne 0 ]; then
        in_place_reason="git diff HEAD exited $_ip_rc"
        return 1
    fi
    _ip_untracked="$(git ls-files --others --exclude-standard -- crates Cargo.toml Cargo.lock rust-toolchain.toml rust-toolchain .cargo 2>/dev/null)" || {
        in_place_reason="git ls-files --others failed"
        return 1
    }
    if [ -n "$_ip_untracked" ]; then
        in_place_reason="untracked files under crates/ or the root cargo files"
        return 1
    fi
    return 0
}

# require_in_place <test id> <sha>: blocks unless <sha> is the clean checkout.
require_in_place() {
    if ! in_place_ok "$2"; then
        echo "" >&2
        echo "pre-push: BLOCKED — $1 for $(git rev-parse --short "$2" 2>/dev/null || printf '%s' "$2") has no recorded pass and it is not the clean checkout here ($in_place_reason)." >&2
        echo "  Push it from the worktree whose clean HEAD is that commit, or commit/stash" >&2
        echo "  the local changes. The hook never checks a commit out elsewhere." >&2
        exit 1
    fi
}

# recorded_pass <tree> <test id>: 0 only when the record script says so.
recorded_pass() {
    [ -f "$RECORD" ] || return 1
    python3 "$RECORD" check --tree "$1" --test "$2"
}

record_pass() {
    [ -f "$RECORD" ] || { echo "pre-push: $RECORD missing — pass for $2 not recorded" >&2; return 0; }
    python3 "$RECORD" record --tree "$1" --test "$2" ||
        echo "pre-push: could not record the pass for $2 (it reruns next push)" >&2
    return 0
}

require_cargo() {
    if ! command -v cargo >/dev/null 2>&1; then
        echo "" >&2
        echo "pre-push: cargo not found, so $1 could not run — blocking rather than" >&2
        echo "assuming it passes. Install the rustup toolchain, or make it visible to" >&2
        echo "git hooks (. \"\$HOME/.cargo/env\")." >&2
        exit 1
    fi
}

# cargo_meta: `cargo metadata --no-deps` of this worktree (in place only).
CARGO_META=""
cargo_meta() {
    [ -n "$CARGO_META" ] && return 0
    CARGO_META="$(cargo metadata --no-deps --format-version 1 2>/dev/null)" || CARGO_META=""
    if [ -z "$CARGO_META" ]; then
        echo "" >&2
        echo "pre-push: BLOCKED — cargo metadata failed, so the crates of this range" >&2
        echo "cannot be mapped to packages." >&2
        exit 1
    fi
}

# pkg_args <crate dir>...: "-p <name>" per dir from $CARGO_META; exits nonzero
# (after a reason on stderr) when metadata is unparseable or a dir does not map
# to exactly one workspace package.
pkg_args() {
    printf '%s' "$CARGO_META" | python3 -c '
import json, os, sys
root = os.path.realpath(sys.argv[1])
try:
    by_dir = {}
    for p in json.load(sys.stdin)["packages"]:
        d = os.path.relpath(os.path.dirname(os.path.realpath(p["manifest_path"])), root)
        by_dir.setdefault(d, []).append(p["name"])
except (ValueError, KeyError, TypeError) as e:
    print("pre-push: cargo metadata not parseable: %r" % (e,), file=sys.stderr)
    sys.exit(2)
out = []
for d in sys.argv[2:]:
    names = by_dir.get(d, [])
    if len(names) != 1:
        print("pre-push: %s maps to %d workspace packages" % (d, len(names)), file=sys.stderr)
        sys.exit(2)
    out += ["-p", names[0]]
print(" ".join(out))
' "$REPO" "$@"
}

# member_dirs: the directory (relative to the repo root) of every workspace
# member in $CARGO_META, one per line; nonzero when none can be listed.
member_dirs() {
    printf '%s' "$CARGO_META" | python3 -c '
import json, os, sys
root = os.path.realpath(sys.argv[1])
try:
    dirs = sorted({os.path.relpath(os.path.dirname(os.path.realpath(p["manifest_path"])), root)
                   for p in json.load(sys.stdin)["packages"]})
except (ValueError, KeyError, TypeError) as e:
    print("pre-push: cargo metadata not parseable: %r" % (e,), file=sys.stderr)
    sys.exit(2)
if not dirs:
    print("pre-push: cargo metadata lists no workspace member", file=sys.stderr)
    sys.exit(2)
print("\n".join(dirs))
' "$REPO"
}

for sha in $pushed_shas; do
    short="$(git rev-parse --short "$sha" 2>/dev/null)" || short="$sha"
    tree="$(git rev-parse --verify --quiet "$sha^{tree}" 2>/dev/null)"
    if [ -z "$tree" ]; then
        echo "" >&2
        echo "pre-push: BLOCKED — the tree of $short could not be resolved, so nothing" >&2
        echo "determinate can be checked or matched against a recorded pass." >&2
        exit 1
    fi

    # --- this sha's range ----------------------------------------------------
    sha_remote="-"
    for pair in ${pushed_remotes:-}; do
        case "$pair" in
            "$sha":*) sha_remote="${pair#*:}"; break ;;
        esac
    done
    range_wide=0
    if [ "$sha_remote" != "-" ]; then
        range_files="$(git diff --name-only "$sha_remote" "$sha" -- 2>/dev/null)" || range_wide=1
    else
        range_files="$(git log --format= --name-only "$sha" --not --remotes -- 2>/dev/null)" || range_wide=1
    fi
    if [ "$range_wide" -eq 1 ]; then
        echo "pre-push: the range of $short could not be computed — checking the whole workspace." >&2
    fi

    cc_dirs=""
    cc_wide="$range_wide"
    cf_need="$range_wide"
    sg_need="$range_wide"
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        case "$f" in
            Cargo.toml|Cargo.lock|rust-toolchain.toml|rust-toolchain|.cargo/*)
                cc_wide=1; cf_need=1 ;;
            crates/*/*)
                _rest="${f#crates/}"
                _d="crates/${_rest%%/*}"
                case " $cc_dirs " in
                    *" $_d "*) ;;
                    *) cc_dirs="$cc_dirs $_d" ;;
                esac
                cf_need=1 ;;
            *.rs|scripts/check-compile-fail.py)
                cf_need=1 ;;
        esac
    done <<EOF
$range_files
EOF
    if printf '%s\n' "$range_files" | grep -Eq "$GATE_PATTERN"; then
        sg_need=1
    fi
    # A touched crate dir with no manifest at S (a deleted or half-added crate)
    # cannot be named with -p; widen rather than skip it.
    for _d in $cc_dirs; do
        git cat-file -e "$sha:$_d/Cargo.toml" 2>/dev/null || cc_wide=1
    done
    cc_id=""
    if [ "$cc_wide" -eq 1 ]; then
        cc_id="cargo-check:workspace"
    elif [ -n "$cc_dirs" ]; then
        _joined=""
        for _d in $(printf '%s\n' $cc_dirs | sort -u); do
            _joined="${_joined:+$_joined,}$_d"
        done
        cc_id="cargo-check:$_joined"
    fi

    # --- blocking check 2: the compiler --------------------------------------
    phase_begin typecheck "$sha"
    if [ -z "$cc_id" ]; then
        echo "pre-push: $short touches no crate and no root cargo file — no cargo check needed." >&2
    elif recorded_pass "$tree" "$cc_id"; then
        echo "pre-push: $cc_id already passed for tree $(printf '%.12s' "$tree") — not rerun" >&2
    else
        require_in_place "$cc_id" "$sha"
        require_cargo "$cc_id"
        if [ "$cc_wide" -eq 1 ]; then
            cc_args="--workspace"
        else
            cargo_meta
            cc_args="$(pkg_args $cc_dirs)" || cc_args=""
            if [ -z "$cc_args" ]; then
                echo "" >&2
                echo "pre-push: BLOCKED — the crates of $short ($cc_id) could not be mapped to" >&2
                echo "workspace packages (see above)." >&2
                exit 1
            fi
        fi
        echo "" >&2
        echo "pre-push: type-checking $short (cargo check --all-targets $cc_args)..." >&2
        if ! cargo check --all-targets --quiet $cc_args >&2; then
            echo "" >&2
            echo "pre-push: BLOCKED — commit $short does not type-check (errors above)." >&2
            echo "Fix the errors rather than routing around the compiler." >&2
            exit 1
        fi
        record_pass "$tree" "$cc_id"
    fi

    # --- blocking check 2b: each touched crate on its own (#1641) ------------
    # One `cargo check` over several packages (--workspace, or -p a -p b) unifies
    # the features of a shared dependency across them, so a crate whose OWN
    # manifest lacks a feature its test targets need (tdd without harness-core's
    # `fault-injection`) compiles there and fails in `cargo test -p tdd`. Each
    # touched crate is therefore also checked alone, in both the wide and the
    # narrow path. This runs whether or not the combined check above was rerun
    # or skipped from its record: every crate has its own test id,
    # `cargo-check:<dir>`, and only a pass recorded for THAT id on THIS tree
    # skips it. That id is deliberately the one the combined check above uses
    # for a narrow range of exactly one crate, because there the combined check
    # IS `cargo check --all-targets -p <crate>` (the same command, so not rerun).
    # A multi-crate id (`cargo-check:crates/a,crates/b`) or
    # `cargo-check:workspace` never equals a single-crate id, so neither skips
    # this step.
    #   * Touched crates: the crates/<dir> in the range that have a Cargo.toml at
    #     S (a dir without one is no package; it already widened the check
    #     above). A range git could not compute has no known crate set, so every
    #     workspace member is checked alone (fail closed).
    #   * A dir that maps to no single package, or member metadata that cannot
    #     be read, blocks.
    if [ -n "$cc_id" ]; then
        pc_dirs=""
        if [ "$range_wide" -eq 1 ]; then
            require_in_place "cargo-check (every member alone)" "$sha"
            require_cargo "cargo-check (every member alone)"
            cargo_meta
            pc_dirs="$(member_dirs)" || pc_dirs=""
            if [ -z "$pc_dirs" ]; then
                echo "" >&2
                echo "pre-push: BLOCKED — the range of $short is unknown and the workspace members" >&2
                echo "could not be listed, so no crate can be checked on its own (see above)." >&2
                exit 1
            fi
        else
            for _d in $cc_dirs; do
                git cat-file -e "$sha:$_d/Cargo.toml" 2>/dev/null && pc_dirs="$pc_dirs $_d"
            done
        fi
        for _d in $(printf '%s\n' $pc_dirs | sort -u); do
            pc_id="cargo-check:$_d"
            # Narrow single-crate range: the combined check above already was
            # this exact check (same id, same command), run or skipped by its
            # record; a failure there has already blocked.
            [ "$pc_id" = "$cc_id" ] && continue
            if recorded_pass "$tree" "$pc_id"; then
                echo "pre-push: $pc_id already passed for tree $(printf '%.12s' "$tree") — not rerun" >&2
                continue
            fi
            require_in_place "$pc_id" "$sha"
            require_cargo "$pc_id"
            cargo_meta
            pc_args="$(pkg_args "$_d")" || pc_args=""
            if [ -z "$pc_args" ]; then
                echo "" >&2
                echo "pre-push: BLOCKED — $_d of $short could not be mapped to one workspace" >&2
                echo "package (see above)." >&2
                exit 1
            fi
            echo "pre-push: type-checking $short crate $_d alone (cargo check --all-targets $pc_args)..." >&2
            if ! cargo check --all-targets --quiet $pc_args >&2; then
                echo "" >&2
                echo "pre-push: BLOCKED — $_d of commit $short does not type-check on its own" >&2
                echo "(errors above). Checked together with other crates it may compile only" >&2
                echo "because Cargo unified a dependency feature this crate's manifest lacks." >&2
                exit 1
            fi
            record_pass "$tree" "$pc_id"
        done
    fi
    phase_end

    # --- blocking check 3: the trybuild type contracts -----------------------
    # `cargo check` never builds the trybuild fixtures, so the compile-fail
    # contracts (harness_core::verdict / scope: "a fail-open is unrepresentable")
    # are run here (backlog 034b6620) whenever the range touches a Rust input.
    # rc=1 (a contract test failed) and rc=2 (undetermined) both block, and so
    # does a tree without the script. check-compile-fail.py keeps its own
    # content-keyed per-target cache on top of this record.
    phase_begin compile-fail "$sha"
    if [ "$cf_need" -eq 0 ]; then
        echo "pre-push: $short touches no Rust input — trybuild contracts not needed." >&2
    elif recorded_pass "$tree" compile-fail; then
        echo "pre-push: compile-fail already passed for tree $(printf '%.12s' "$tree") — not rerun" >&2
    else
        require_in_place compile-fail "$sha"
        require_cargo compile-fail
        if [ ! -f "$REPO/scripts/check-compile-fail.py" ]; then
            echo "" >&2
            echo "pre-push: BLOCKED — commit $short has no scripts/check-compile-fail.py," >&2
            echo "so its trybuild type contracts cannot be checked. Rebase/merge onto a" >&2
            echo "main that has it (backlog 034b6620)." >&2
            exit 1
        fi
        echo "pre-push: trybuild compile-fail contracts at $short (scripts/check-compile-fail.py)..." >&2
        # The script's stderr is passed through prepush_cf_filter (unchanged,
        # line by line) only to time each trybuild target. Its exit status and
        # the per-target times come back on fd 3; a status that did not come
        # back is treated as 2 (undetermined), never as 0.
        _cf_out="$( { { ( cd "$REPO" && python3 scripts/check-compile-fail.py >&2 ) 2>&1 3>&-; echo "RC $?" >&3; } \
              | prepush_cf_filter >&2; } 3>&1 )"
        compile_fail_rc=""
        while IFS= read -r _cf_r; do
            case "$_cf_r" in
                "RC "*) compile_fail_rc="${_cf_r#RC }" ;;
                "T "*)
                    _cf_rest="${_cf_r#T }"
                    _cf_tl="${_cf_rest% *}"; _cf_ts="${_cf_rest##* }"
                    case "$_cf_ts" in ''|*[!0-9]*) _cf_ts="" ;; esac
                    _tm_extra_sum="${_tm_extra_sum:+$_tm_extra_sum, }$_cf_tl ${_cf_ts:-?}s"
                    _tm_extra_json="${_tm_extra_json:+$_tm_extra_json,}\"$_cf_tl\":${_cf_ts:-null}" ;;
                "S "*)
                    _cf_tl="${_cf_r#S }"
                    _tm_extra_sum="${_tm_extra_sum:+$_tm_extra_sum, }$_cf_tl skipped"
                    _tm_extra_json="${_tm_extra_json:+$_tm_extra_json,}\"$_cf_tl\":\"skipped\"" ;;
            esac
        done <<EOF
$_cf_out
EOF
        case "$compile_fail_rc" in ''|*[!0-9]*) compile_fail_rc=2 ;; esac
        if [ "$compile_fail_rc" -ne 0 ]; then
            echo "" >&2
            echo "pre-push: BLOCKED — trybuild compile-fail check at $short exited" >&2
            echo "$compile_fail_rc (1 = a type contract failed, 2 = could not be determined)." >&2
            echo "See the output above." >&2
            exit 1
        fi
        record_pass "$tree" compile-fail
    fi
    phase_end

    # --- blocking check 4: gate-crate spec-doc coverage ----------------------
    # A change to a blocking gate crate must not leave this machine while the
    # file it touched is described by no spec doc and acknowledged by nobody
    # (`specguard map gate-check`, backlog 0c277117).
    #
    # The map is built FRESH into a temp file (`--map-path`): the worktree's own
    # .specguard/spec-map.toml is a gitignored machine-local cache whose
    # spec_doc would otherwise satisfy the check, so it is never read or written
    # here. Only the two TRACKED files can satisfy it: .specguard/spec-docs.toml
    # and .specguard/spec-doc-acks.toml. The specguard that judges is built
    # from the pushed tree (it is the clean checkout), not the plugin cache.
    #
    # FAIL-CLOSED: rc=1 (uncovered) and rc=2 (undetermined) block, and so does a
    # specguard that cannot be built or lacks `--map-path` (a tree that predates
    # it: rebase onto main).
    sha_base=""
    for pair in ${pushed_pairs:-}; do
        case "$pair" in
            "$sha":*) sha_base="${pair#*:}"; break ;;
        esac
    done
    if [ -z "$sha_base" ]; then
        sha_base="$(git rev-parse --verify --quiet "${sha}^" 2>/dev/null)"
        [ -n "$sha_base" ] || sha_base="$EMPTY_TREE"
    fi
    if [ "$sg_need" -eq 1 ]; then
        sg_id="specguard-gate-check:$sha_base"
        phase_begin specguard "$sha"
        if recorded_pass "$tree" "$sg_id"; then
            echo "pre-push: $sg_id already passed for tree $(printf '%.12s' "$tree") — not rerun" >&2
        else
            require_in_place "$sg_id" "$sha"
            require_cargo "$sg_id"
            echo "pre-push: gate spec-doc check at $short (specguard map gate-check)..." >&2
            if ! cargo build --quiet -p specguard --bin specguard >&2; then
                echo "" >&2
                echo "pre-push: BLOCKED — specguard could not be built from $short, so its" >&2
                echo "gate-crate spec-doc coverage could not be checked." >&2
                exit 1
            fi
            cargo_meta
            sg_target="$(printf '%s' "$CARGO_META" | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])' 2>/dev/null)" || sg_target=""
            SPECGUARD_BIN="$sg_target/debug/specguard"
            if [ -z "$sg_target" ] || [ ! -x "$SPECGUARD_BIN" ]; then
                echo "" >&2
                echo "pre-push: BLOCKED — the built specguard was not found (target dir" >&2
                echo "'${sg_target:-unknown}' from cargo metadata)." >&2
                exit 1
            fi
            SPECMAP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/prepush-specmap.XXXXXX" 2>/dev/null)" || SPECMAP_TMP=""
            if [ -z "$SPECMAP_TMP" ]; then
                echo "pre-push: BLOCKED — no temp dir for the fresh spec map." >&2
                exit 1
            fi
            if ! "$SPECGUARD_BIN" --map-path "$SPECMAP_TMP/spec-map.toml" map build --baseline "$sha_base" >/dev/null 2>&1; then
                echo "" >&2
                echo "pre-push: BLOCKED — a fresh spec map could not be built at $short" >&2
                echo "(specguard --map-path <tmp> map build --baseline $sha_base). A specguard" >&2
                echo "without --map-path predates this hook: rebase onto main." >&2
                exit 1
            fi
            "$SPECGUARD_BIN" --map-path "$SPECMAP_TMP/spec-map.toml" map gate-check --base "$sha_base" --head "$sha" >&2
            gate_check_rc=$?
            cleanup_specmap
            SPECMAP_TMP=""
            if [ "$gate_check_rc" -ne 0 ]; then
                echo "" >&2
                echo "pre-push: BLOCKED — gate spec-doc check at $short exited $gate_check_rc" >&2
                echo "(1 = a changed gate-crate entry has no spec doc and no reasoned ack," >&2
                echo "2 = could not be determined). See the output above." >&2
                echo "Fix: bind the file in .specguard/spec-docs.toml (path/doc/reason, doc = an" >&2
                echo "existing docs/specs/*.md) or ack it in .specguard/spec-doc-acks.toml" >&2
                echo "(path/reason). Both are tracked; 'specguard map set-spec' writes only the" >&2
                echo "machine-local map and does not satisfy this check." >&2
                exit 1
            fi
            record_pass "$tree" "$sg_id"
        fi
        phase_end
    fi

    # --- blocking check 5: fail-open mutation over the range's gate crates ---
    # scripts/check-fail-open-mutation.py copies this tree into a scratch
    # temporary directory (user ruling 2026-11-14: the invoking tree is never
    # written), applies each gate crate's registered fail-open mutation to
    # the COPY, runs `cargo test -p <crate>` in the copy (its own
    # CARGO_TARGET_DIR) over that scenario's declared test targets (the
    # targets observed to go RED under the mutation and to pass without it;
    # the whole crate when none are declared), requires RED, then removes the
    # copy and verifies this tree's target file is byte-identical. Nothing at
    # commit time runs it, so it runs here (backlog 4f19b628 / issue #1584).
    #
    # SCOPE: per crate, only the gate crates whose crates/<gate>/ this range
    # touches. A range that cannot be computed, or a change to the mutation
    # script itself, runs every gate crate. A root cargo-file change alone
    # (Cargo.toml/Cargo.lock/toolchain) does NOT select any gate crate: it
    # widens `cargo check` above, but it is not a change to a gate crate's own
    # range, so it is not measured here (user ruling 2026-11-08: range only). Granularity is the crate, NOT the
    # individual changed Undetermined arm: the script's interface is `--crate`
    # and has no per-arm selector; a changed arm with no registered scenario
    # is not measured here.
    #
    # FAIL-CLOSED: any nonzero exit (NOT CAUGHT, inconclusive, setup error,
    # scratch copy that cannot be created/mutated/tested/removed, crash) blocks; so does a tree without the script or a
    # missing python3. A pass is recorded per crate for this tree.
    fm_crates=""
    fm_all="$range_wide"
    if printf '%s\n' "$range_files" | grep -qx 'scripts/check-fail-open-mutation.py'; then
        fm_all=1
    fi
    for _g in blastguard propguard specguard stuckguard mutategate overwatch parallelguard; do
        if [ "$fm_all" -eq 1 ] || printf '%s\n' "$range_files" | grep -q "^crates/$_g/"; then
            fm_crates="$fm_crates $_g"
        fi
    done
    if [ -n "$fm_crates" ]; then
        phase_begin fail-open-mutation "$sha"
        for _g in $fm_crates; do
            fm_id="fail-open-mutation:$_g"
            if recorded_pass "$tree" "$fm_id"; then
                echo "pre-push: $fm_id already passed for tree $(printf '%.12s' "$tree") — not rerun" >&2
                continue
            fi
            require_in_place "$fm_id" "$sha"
            require_cargo "$fm_id"
            if ! command -v python3 >/dev/null 2>&1 || [ ! -f "$REPO/scripts/check-fail-open-mutation.py" ]; then
                echo "" >&2
                echo "pre-push: BLOCKED — python3 or scripts/check-fail-open-mutation.py is" >&2
                echo "missing at $short, so the $_g fail-open mutation cannot be measured." >&2
                exit 1
            fi
            echo "pre-push: fail-open mutation for $_g at $short (scripts/check-fail-open-mutation.py --crate $_g)..." >&2
            ( cd "$REPO" && python3 scripts/check-fail-open-mutation.py --crate "$_g" --keep-going ) >&2
            fm_rc=$?
            if [ "$fm_rc" -ne 0 ]; then
                echo "" >&2
                echo "pre-push: BLOCKED — fail-open mutation check for $_g at $short exited" >&2
                echo "$fm_rc (a mutation was NOT CAUGHT, inconclusive, errored, or its scratch" >&2
                echo "copy cleanup is unconfirmed). See the output above; run git status." >&2
                exit 1
            fi
            record_pass "$tree" "$fm_id"
        done
        phase_end
    fi
done

# --- the last blocking check: the pushed refs still name the certified shas --
# Every check above judged the local_sha values git gave on stdin. Over a remote
# helper transport (http/https), git hands the helper the refspec BY NAME and the
# helper re-reads the local ref AFTER this hook returns. So if a ref moves while
# the hook runs (a concurrent merge in another session), the remote receives a
# commit this hook never checked. Observed 2026-10-25 on this repo: a push whose
# hook certified 2f8e4209 delivered 4d3dd426, so 0241c62f and 4d3dd426 reached
# origin unchecked (backlog d222b3e3, scripts/test_prepush_ref_moved_during_hook.py).
#
# This re-check NARROWS the window but does NOT close it: a ref can still move
# between this re-check and the moment the transport re-reads it. A residual
# window remains; the race is not closed. Pushing a sha (`git push origin
# <sha>:main`) or over file:// does not have it at all.
#
# FAIL-CLOSED: a moved ref blocks, and so does a ref that cannot be resolved
# (cannot determine what git will send is not "it is what was certified").
# Delete lines (all-zero local_sha) send no commit and are skipped.
phase_begin ref-recheck
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    current_sha="$(git rev-parse --verify --quiet "$local_ref" 2>/dev/null)"
    if [ -z "$current_sha" ] || [ "$current_sha" != "$local_sha" ]; then
        echo "" >&2
        echo "pre-push: BLOCKED — $local_ref moved while this hook ran." >&2
        echo "  certified sha: $local_sha" >&2
        echo "  current sha:   ${current_sha:-(cannot be resolved)}" >&2
        echo "Over https git re-reads the ref after this hook returns, so the remote" >&2
        echo "would receive a commit no check above has seen. Push again." >&2
        exit 1
    fi
done <<EOF
$PUSH_INPUT
EOF
phase_end

exit 0
