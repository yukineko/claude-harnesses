#!/bin/sh
# blastguard plugin launcher — selects the per-platform binary bundled in this dir.
#
# Hooks call `${CLAUDE_PLUGIN_ROOT}/bin/blastguard`; this dispatcher execs the
# matching `blastguard-<os>-<arch>` build.
#
# WHEN NO BUILD EXISTS FOR THE HOST, the answer is NOT a blanket "exit 0" — an
# Allow verdict IS silent exit 0 with no stdout (see hookio::decision_line), so
# a silent exit 0 here is byte-for-byte indistinguishable downstream from
# "blastguard examined this call and found nothing destructive" (CLAUDE.md
# §1/§3). Unlike taintguard/ctxrot, blastguard has no gate/mark/clear split —
# it is a single PreToolUse verdict entrypoint — so a missing binary is ALWAYS
# a missing verdict and must emit one, never stay silent.
#
# The fallback mirrors crate::interactive::ask_available's positive-interactive
# check byte-for-byte (same env vars, same resolution order, same default),
# so the shell fallback obeys the exact policy the compiled binary does:
#   * BLASTGUARD_ASK=never  -> never ask (force deny).
#   * BLASTGUARD_ASK=always -> always ask (operator has verified their env).
#   * BLASTGUARD_ASK=auto / unset -> ask only when CLAUDECODE=1 AND
#     CLAUDE_CODE_ENTRYPOINT=cli (the one measured affirmatively-interactive
#     value; see crate::interactive module docs). Anything else -> deny.
# "ask にできないときは fail": no human present means the missing verdict
# hardens to deny, never to a silent allow.
root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -s)" in
  Linux)  os=linux ;;
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *)      os="$(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64|amd64)   arch=x86_64 ;;
  arm64|aarch64)  arch=arm64 ;;
  *)              arch="$(uname -m)" ;;
esac

ext=""
[ "$os" = windows ] && ext=".exe"

binary="$root/blastguard-$os-$arch$ext"
if [ -x "$binary" ]; then
  exec "$binary" "$@"
fi

echo "blastguard: no bundled binary for $os-$arch ($binary)." >&2

reason="blastguard did not run: no bundled binary for $os-$arch. Whether this command is destructive was NOT evaluated, so it is UNCHECKED, not approved. Build it with scripts/build-plugin-bin.sh on that platform, or remove the blastguard hooks."

case "${BLASTGUARD_ASK:-auto}" in
  never)
    decision=deny
    ;;
  always)
    decision=ask
    ;;
  auto)
    if [ "$CLAUDECODE" = "1" ] && [ "$CLAUDE_CODE_ENTRYPOINT" = "cli" ]; then
      decision=ask
    else
      decision=deny
    fi
    ;;
  *)
    decision=deny
    ;;
esac

printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"%s","permissionDecisionReason":"%s"}}\n' \
  "$decision" "$reason"
exit 0
