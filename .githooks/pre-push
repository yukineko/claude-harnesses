#!/bin/sh
# Versioned pre-push hook. Enable once per clone with:
#
#     git config core.hooksPath .githooks
#
# This is an ADVISORY-ONLY nudge with four checks:
#   1. GATE crates — when the push touches blastguard/propguard/specguard/
#      stuckguard/mutategate/overwatch (the fleet defense gates), suggest a
#      Continuous-Audit round (`scripts/continuous-audit.sh --dry-run`).
#   2. Rollout drift — `scripts/check-plugin-rollout.py` reports plugins whose
#      committed+bumped version was never actually rolled out to the live plugin
#      cache. That fix then reaches NO session. This has to live here rather than
#      in CI: the check reads ~/.claude/plugins/installed_plugins.json, which is
#      a property of the developer's machine and does not exist on a runner.
#   3. Autonomy chain — when the push touches the crates whose SKILL specs the
#      human-0 chain depends on (condukt/scout/flow/backlog), suggest re-running
#      `scripts/e2e-autonomy.sh`, which asserts the gate contracts that remove
#      every AskUserQuestion stop. Also machine-local (needs installed binaries).
#   4. Chronically-red CI — `scripts/check-ci-red.py` names workflows that have
#      failed N runs in a row on main, and separately names the ones it could
#      NOT judge. This repo has no required status checks, so a red workflow
#      blocks nothing and tells no one: one clippy lint stayed red for 89
#      consecutive runs unnoticed. Pinning the toolchain would have bought
#      silence by giving up the detection; the defect was the silence, so this
#      is where it gets fixed. Machine-local for the same reason as (2): it
#      needs an authenticated `gh`, and running a check *about* CI inside CI is
#      circular. Always inspects `main` — the shared branch whose rot is the
#      problem — regardless of which ref is being pushed.
#
# It NEVER blocks the push: this hook always exits 0, matching the fail-soft
# invariant used by `.githooks/pre-commit` (injectguard) and the Continuous-Audit
# loop itself (opt-in tooling, not an always-on gate). Every check degrades to
# silence if its prerequisite (python3, the script, the registry) is absent.
#
# Formalizes the pre-push fragment sketched in
# scripts/continuous-audit.cron.example into a real, installable hook.
#
# Manual test (no real push needed):
#   printf 'refs/heads/main %s refs/heads/main %s\n' "$(git rev-parse HEAD)" "$(git rev-parse HEAD~1)" \
#     | bash .githooks/pre-push origin https://example.invalid/repo.git

set -u

REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO" 2>/dev/null || exit 0

GATE_PATTERN='^crates/(blastguard|propguard|specguard|stuckguard|mutategate|overwatch)/'

# Crates whose SKILL specs carry the autonomy gate contracts asserted by
# scripts/e2e-autonomy.sh (scout selection/hand-off, condukt agreement, flow
# human gates). Deliberately NOT parsed by check-gate-crates-sync.py — this is
# the autonomy chain, a different set from the defense-gate GATE_CRATES above.
AUTONOMY_PATTERN='^crates/(condukt|scout|flow|backlog)/'

# git invokes pre-push with zero-or-more "<local-ref> <local-sha> <remote-ref> <remote-sha>"
# lines on stdin, one per updated ref. Collect the set of changed files across
# all pushed ranges. If stdin gives us nothing usable (e.g. manual invocation
# without piped refs), fall back to the @{push}..HEAD range, and finally to
# just-in-case skip (never fail the push over inability to compute a diff).
changed=""
saw_ref=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    saw_ref=1
    # Deleting a ref (local_sha all zeros) has nothing to diff.
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    has_remote=0
    if [ -n "${remote_sha:-}" ]; then
        case "$remote_sha" in
            0000000000000000000000000000000000000000) has_remote=0 ;;
            *) git cat-file -e "$remote_sha" 2>/dev/null && has_remote=1 ;;
        esac
    fi
    if [ "$has_remote" = "1" ]; then
        diff_out="$(git diff --name-only "$remote_sha..$local_sha" -- 2>/dev/null)"
    else
        # No known remote tip (new branch / new ref) — diff against the
        # local sha's parents isn't well-defined generically, so list files
        # touched by the tip commit as a best-effort signal.
        diff_out="$(git show --name-only --pretty=format: "$local_sha" 2>/dev/null)"
    fi
    changed="$changed
$diff_out"
done

if [ "$saw_ref" = "0" ]; then
    # No ref-update lines were readable from stdin at all (likely a manual/
    # non-standard invocation, not a real git-invoked pre-push) — fall back
    # to the range since the upstream tracking branch as a best-effort check.
    changed="$(git diff --name-only '@{push}..HEAD' 2>/dev/null || true)"
fi

if printf '%s\n' "$changed" | grep -Eq "$GATE_PATTERN"; then
    cat >&2 <<'EOF'

continuous-audit: gate-crate changes detected in this push (blastguard/
propguard/specguard/stuckguard/mutategate/overwatch). Consider running a
Continuous-Audit round before or after pushing:

    scripts/continuous-audit.sh --dry-run

This is advisory only — the push is not blocked.
EOF
fi

if printf '%s\n' "$changed" | grep -Eq "$AUTONOMY_PATTERN"; then
    cat >&2 <<'EOF'

e2e-autonomy: changes detected under a crate the human-0 chain depends on
(condukt/scout/flow/backlog). The autonomy gate contracts are asserted by:

    scripts/e2e-autonomy.sh

It re-checks the deterministic layer only (autonomy switch + gate contracts +
queue wiring), skips loudly if autonomy is off, and touches no real state.
This is advisory only — the push is not blocked.
EOF
fi

# Rollout drift: a committed + version-bumped plugin whose fix was never rolled
# out to the live cache reaches no session at all. The checker exits 0 when the
# registry is absent (e.g. a machine with no plugins installed), so this stays
# quiet where it does not apply. Skipped entirely without python3 or the script.
#
# The checker distinguishes its failure CLASSES by exit code (rc=1 rollout
# drift, rc=2 enablement) because they have OPPOSITE fixes. Branching on a bare
# non-zero and then unconditionally printing the rollout prose told the reader
# to run `scripts/rollout-plugins.sh` for a disabled-GATE-crate failure — the
# one command that, by the checker's own hint, does NOT enable plugins. So: the
# checker's own output (which already carries the right Fix line for whichever
# class fired) is always echoed, and the extra rollout prose is added only for
# the rollout class. Any other non-zero rc is unrecognized: echo and say so
# rather than inventing a remediation for it.
if command -v python3 >/dev/null 2>&1 && [ -f scripts/check-plugin-rollout.py ]; then
    rollout_out="$(python3 scripts/check-plugin-rollout.py 2>&1)"
    rollout_rc=$?
    if [ "$rollout_rc" -ne 0 ]; then
        printf '\n%s\n' "$rollout_out" >&2
    fi
    case "$rollout_rc" in
        0) ;;
        1)
            cat >&2 <<'EOF'

rollout: the versions above are committed but not live — the fix is in git and
reaches no session until you roll it out:

    scripts/rollout-plugins.sh --plugin <name>            # add --canary for GATE crates

This is advisory only — the push is not blocked.
EOF
            ;;
        3)
            # Unverifiable class. Neither a rollout nor an enablement edit can
            # fix it: the checker could not read a plugin.json at all, so the
            # population it inspected is incomplete and NOTHING it reported is a
            # complete verdict. Naming either remedy here would send the reader
            # to a command that cannot help — and, worse, imply the rest of the
            # report was verified when it was not.
            cat >&2 <<'EOF'

unverifiable: a crate under crates/ ships a plugin.json that could not be read
or parsed, so the rollout and enablement checks above covered an INCOMPLETE set
of plugins. Treat their result as unknown, not as a pass — fix the file named in
the Fix line above and re-run.

This is advisory only — the push is not blocked.
EOF
            ;;
        2)
            # Enablement class. Deliberately does NOT mention rollout-plugins.sh:
            # the checker's own Fix line above names the real remedy (edit
            # enabledPlugins in settings.json, then restart Claude Code).
            cat >&2 <<'EOF'

enablement: see the Fix line above — this class is NOT fixed by a rollout.
A GATE crate that is installed but not listed in enabledPlugins is inert: its
hooks never fire, so the gate reports nothing and guards nothing.

This is advisory only — the push is not blocked.
EOF
            ;;
        *)
            printf '\n%s\n' "rollout check: unrecognized exit code $rollout_rc — see its output above. This is advisory only; the push is not blocked." >&2
            ;;
    esac
fi

# Chronically-red CI. Only the chronic class (default: 3+ consecutive failures)
# is surfaced; a single red run is usually a flake or a mistake already being
# fixed, and saying the same thing about both trains the reader to ignore both.
#
# The checker exits 0 for every "cannot tell" case (no gh, no auth, offline,
# timeout, unparseable output) and prints its reason to stderr, so an offline
# push stays quiet without ever being mistaken for an all-clear. Set
# PREPUSH_SKIP_CI_RED=1 to skip the network call entirely.
# Branching is on EXIT CODE, never on the output text. An earlier version
# matched the literal string "check-ci-red: skipped" to tell "could not ask"
# from "CI is fine" — so rewording one message would have silently turned this
# into a no-op, which is precisely the failure mode the check exists to catch.
#   0 = every active workflow judged, none chronic   1 = chronically red
#   3 = something could not be determined            * = unrecognized
if [ "${PREPUSH_SKIP_CI_RED:-0}" != "1" ] \
    && command -v python3 >/dev/null 2>&1 && [ -f scripts/check-ci-red.py ]; then
    ci_out="$(python3 scripts/check-ci-red.py --branch main 2>&1)"
    ci_rc=$?
    if [ "$ci_rc" -ne 0 ]; then
        printf '\n%s\n' "$ci_out" >&2
    fi
    case "$ci_rc" in
        0) ;;
        1)
            # Says "chronically" rather than "already broken before this push":
            # the report can also carry a recently-red section, and a fresh red
            # there may well be from the developer's own previous push.
            # The script's own output already explains the class and how to
            # inspect it; only the push-safety line is added here.
            printf '%s\n' "This is advisory only — the push is not blocked." >&2
            ;;
        3)
            cat >&2 <<'EOF'

CI health could not be fully determined — treat the above as UNKNOWN, not as an
all-clear. A workflow that cannot be judged is exactly the one most likely to
have rotted unnoticed. This is advisory only — the push is not blocked.
EOF
            ;;
        *)
            printf '\n%s\n' "check-ci-red: unrecognized exit code $ci_rc — see its output above. NOT an all-clear. This is advisory only; the push is not blocked." >&2
            ;;
    esac
fi

exit 0
