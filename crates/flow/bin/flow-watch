#!/usr/bin/env python3
"""flow-watch: deterministic anti-stall watcher for /flow (spec: crates/flow/WATCH-SPEC.md).

Every stdout line is an event the driver must act on. Silence means "nothing to do";
anything unreadable/unparsable is reported as WATCH-ERROR, never skipped (fail-closed).
"""
import argparse
import json
import os
import subprocess
import sys
import time

MISSING = object()  # a list-tasks row without the key at all


def out(line):
    try:
        sys.stdout.write(line.replace("\n", " ") + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        os._exit(0)


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        sys.stderr.write("flow-watch: error: %s\n" % message)
        sys.exit(2)


def parse_args():
    p = Parser(prog="flow-watch")
    p.add_argument("--session", required=True)
    p.add_argument("--project", required=True)
    p.add_argument("--relay-queue")
    p.add_argument("--watch-state")
    p.add_argument("--run", action="append", default=[])
    p.add_argument("--poll-secs", type=float, default=5)
    p.add_argument("--state-secs", type=float, default=60)
    p.add_argument("--heartbeat-secs", type=float, default=600)
    p.add_argument("--relay-stall-secs", type=float, default=120)
    p.add_argument("--task-stall-secs", type=float, default=1200)
    p.add_argument("--max-secs", type=float, default=1700)
    a = p.parse_args()
    for n in ("poll_secs", "state_secs", "heartbeat_secs", "relay_stall_secs",
              "task_stall_secs", "max_secs"):
        if getattr(a, n) <= 0:
            p.error("--%s must be > 0" % n.replace("_", "-"))
    return a


class Watch:
    def __init__(self, a):
        self.a = a
        self.queue = a.relay_queue or os.path.expanduser(
            "~/.blastguard/relay/%s.jsonl" % a.session)
        self.relayed = set()
        self.relay_stall_at = {}
        self.errors = set()
        self.stall_at = {}        # (run, task) -> time of last TASK-STALL
        # v2 run tracking
        self.watched = {}         # run_id -> {task_id: {"status": str, "since": float}}
        self.baseline = set()     # run ids present at the first poll of a fresh watch
        self.baselined = False
        # run ownership: post-baseline runs not owned by --session are never watched.
        # In-memory only (not persisted): after a re-arm they are classified again.
        self.foreign = set()      # runs owned by a different, named session: silent
        self.unowned = set()      # runs whose owner is undetermined: one WATCH-UNOWNED each
        self.no_write = False     # set when an existing watch-state could not be read
        self.dirty = False
        self.wstate = a.watch_state or os.path.join(
            os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state"),
            "claude-harnesses", "flow-watch", "%s.json" % a.session.replace("/", "_"))
        self.load_watch_state()
        for r in a.run:
            if r not in self.watched:
                self.watched[r] = {}
                self.dirty = True

    def error(self, key, text):
        if key in self.errors:
            return
        self.errors.add(key)
        out("WATCH-ERROR %s" % text)

    # ---- relay
    def poll_relay(self, now):
        q = self.queue
        if not os.path.lexists(q):
            return  # no relays yet
        try:
            with open(q, "r", encoding="utf-8", errors="replace") as f:
                raw = f.read()
        except OSError as e:
            self.error(("q", str(e)), "relay queue %s: unreadable: %s" % (q, e))
            return
        queued, adjudicated = {}, set()
        for n, line in enumerate(raw.splitlines(), 1):
            if not line.strip():
                continue
            try:
                row = json.loads(line)
                if not isinstance(row, dict):
                    raise ValueError("row is not an object")
            except ValueError as e:
                self.error(("ql", n, line), "relay queue %s line %d: unparsable: %s" % (q, n, e))
                continue
            ev, rid = row.get("event"), row.get("id")
            if ev in ("queued", "executed", "dismissed") and not isinstance(rid, str):
                self.error(("qi", n, line), "relay queue %s line %d: %s row without string id" % (q, n, ev))
                continue
            if ev == "queued":
                queued.setdefault(rid, row)
            elif ev in ("executed", "dismissed"):
                adjudicated.add(rid)
        for rid, row in queued.items():
            if rid in adjudicated:
                continue
            if rid not in self.relayed:
                self.relayed.add(rid)
                out("RELAY %s agent=%s cwd=%s" % (rid, row.get("agent_id", ""), row.get("cwd", "")))
            ts = row.get("ts")
            if isinstance(ts, bool) or not isinstance(ts, (int, float)):
                self.error(("qts", rid), "relay queue %s id %s: missing/invalid ts, cannot age" % (q, rid))
                continue
            age = now - ts
            if age >= self.a.relay_stall_secs:
                last = self.relay_stall_at.get(rid)
                if last is None or now - last >= self.a.relay_stall_secs:
                    self.relay_stall_at[rid] = now
                    out("RELAY-STALL %s age=%ds" % (rid, int(age)))

    # ---- condukt state
    def load_watch_state(self):
        p = self.wstate
        if not os.path.lexists(p):
            return  # fresh watch
        try:
            with open(p, "r", encoding="utf-8") as f:
                data = json.load(f)
            if not isinstance(data, dict):
                raise ValueError("top level is not an object")
            watched = data.get("watched", {})
            baseline = data.get("baseline", [])
            if not isinstance(watched, dict) or not isinstance(baseline, list):
                raise ValueError("`watched` must be an object and `baseline` a list")
            w = {}
            for run, tasks in watched.items():
                if not isinstance(tasks, dict):
                    raise ValueError("watched run %r is not an object" % run)
                w[run] = {}
                for t, rec in tasks.items():
                    if (not isinstance(rec, dict) or not isinstance(rec.get("status"), str)
                            or isinstance(rec.get("since"), bool)
                            or not isinstance(rec.get("since"), (int, float))):
                        raise ValueError("watched task %s/%s lacks status/since" % (run, t))
                    w[run][t] = {"status": rec["status"], "since": float(rec["since"])}
            if not all(isinstance(b, str) for b in baseline):
                raise ValueError("`baseline` has a non-string entry")
        except (OSError, ValueError) as e:
            # never overwrite what we could not read; start empty and fresh
            self.no_write = True
            self.error(("ws-load", str(e)), "watch-state: %s: unreadable, starting with an empty watched set and leaving the file untouched: %s" % (p, e))
            return
        self.watched = w
        self.baseline = set(baseline)
        self.baselined = True

    def save_watch_state(self):
        if self.no_write or not self.dirty:
            return
        p = self.wstate
        doc = {"version": 2, "baseline": sorted(self.baseline), "watched": self.watched}
        try:
            os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
            tmp = "%s.tmp.%d" % (p, os.getpid())
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(doc, f)
            os.replace(tmp, p)
            self.dirty = False
        except OSError as e:
            self.error(("ws-save", str(e)), "watch-state: %s: write failed: %s" % (p, e))

    def list_tasks(self):
        """Return list of (run, task, status, owner_session, terminal_label), or raise
        ValueError(reason). owner_session / terminal_label are passed through raw (any
        JSON value, or MISSING when the key is absent) and classified by the caller."""
        exe = os.environ.get("FLOW_WATCH_CONDUKT") or "condukt"
        if not os.path.isdir(self.a.project):
            raise ValueError("--project %s is not a directory" % self.a.project)
        try:
            p = subprocess.run([exe, "state", "list-tasks"], cwd=self.a.project,
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, timeout=60)
        except FileNotFoundError:
            raise ValueError("rc=127: %s not found" % exe)
        except PermissionError:
            raise ValueError("rc=126: %s not executable" % exe)
        except subprocess.TimeoutExpired:
            raise ValueError("rc=124: timed out")
        except OSError as e:
            raise ValueError("rc=126: %s" % e)
        if p.returncode != 0:
            raise ValueError("rc=%d" % p.returncode)
        try:
            rows = json.loads(p.stdout.decode("utf-8", errors="replace"))
        except ValueError as e:
            raise ValueError("non-JSON stdout: %s" % e)
        if not isinstance(rows, list):
            raise ValueError("stdout is not a JSON array")
        res = []
        for r in rows:
            if (not isinstance(r, dict) or not all(isinstance(r.get(k), str)
                                                   for k in ("run_id", "task_id", "status"))):
                raise ValueError("row without string run_id/task_id/status: %.200r" % (r,))
            res.append((r["run_id"], r["task_id"], r["status"],
                        r.get("owner_session", MISSING), r.get("terminal_label", MISSING)))
        return res

    def poll_state(self, now):
        try:
            rows = self.list_tasks()
        except ValueError as e:
            self.error(("lt", str(e)), "condukt list-tasks: %s" % e)
            return  # a failed poll changes nothing; never read as "no tasks"
        by_run, owners, labels = {}, {}, {}
        for run, task, status, owner, label in rows:
            by_run.setdefault(run, []).append((task, status))
            owners.setdefault(run, []).append(owner)
            if isinstance(label, str):
                labels.setdefault(run, label)
        if not self.baselined:
            for run in by_run:
                if run not in self.watched:
                    self.baseline.add(run)
            self.baselined = True
            self.dirty = True
        else:
            for run in sorted(by_run):
                if (run in self.baseline or run in self.watched
                        or run in self.foreign or run in self.unowned):
                    continue
                kind = self.ownership(owners[run])
                if kind == "own":
                    self.watched[run] = {}
                    self.dirty = True
                elif kind == "foreign":
                    self.foreign.add(run)
                else:
                    self.unowned.add(run)
                    out("WATCH-UNOWNED %s label=%s" % (run, labels.get(run, "unknown")))
        # foreign / unowned runs that left the listing are forgotten
        self.foreign &= set(by_run)
        self.unowned &= set(by_run)
        # baseline entries that left the listing are pruned
        gone = {r for r in self.baseline if r not in by_run}
        if gone:
            self.baseline -= gone
            self.dirty = True
        for run in sorted(self.watched):
            cur = by_run.get(run)
            old = self.watched[run]
            if cur is None:
                if old:  # was seen listed and has now disappeared
                    out("STATE %s finished" % run)
                    del self.watched[run]
                    self.dirty = True
                    for k in [k for k in self.stall_at if k[0] == run]:
                        del self.stall_at[k]
                continue  # --run for a run not yet listed: keep waiting
            new = {}
            for t, s in cur:
                prev = old.get(t)
                new[t] = prev if prev and prev["status"] == s else {"status": s, "since": now}
            if {t: v["status"] for t, v in old.items()} != {t: v["status"] for t, v in new.items()}:
                out("STATE %s %s" % (run, " ".join("%s=%s" % (t, v["status"]) for t, v in new.items())))
            if new != old:
                self.watched[run] = new
                self.dirty = True
            for t, v in new.items():
                if v["status"] != "running":
                    continue
                idle = now - v["since"]
                if idle < self.a.task_stall_secs:
                    continue
                last = self.stall_at.get((run, t))
                if last is None or now - last >= self.a.task_stall_secs:
                    self.stall_at[(run, t)] = now
                    out("TASK-STALL %s %s status=running idle=%ds" % (run, t, int(idle)))
        self.save_watch_state()

    def ownership(self, owners):
        """Classify a run from the owner_session of each of its rows:
        "own"     - every row names --session;
        "foreign" - every row names the same session (a non-blank string) other than --session;
        "unowned" - anything else: null, missing, not a string, blank, or rows that
                    disagree. Undetermined is surfaced (WATCH-UNOWNED), never dropped."""
        if not owners or not all(isinstance(o, str) and o.strip() for o in owners):
            return "unowned"
        if all(o == self.a.session for o in owners):
            return "own"
        if len(set(owners)) == 1:
            return "foreign"
        return "unowned"

    # ---- heartbeat
    def heartbeat(self):
        a = self.a
        cmds = (
            ("condukt", os.environ.get("FLOW_WATCH_CONDUKT") or "condukt",
             ["state", "heartbeat", "--run", "flow-%s" % a.session]),
            ("backlog", os.environ.get("FLOW_WATCH_BACKLOG") or "backlog",
             ["driver", "heartbeat", "--session-id", a.session, "--project", a.project]),
        )
        for which, exe, args in cmds:
            try:
                rc = subprocess.run([exe] + args, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    timeout=60).returncode
            except FileNotFoundError:
                rc = 127
            except PermissionError:
                rc = 126
            except subprocess.TimeoutExpired:
                rc = 124
            except OSError:
                rc = 126
            if rc != 0:
                out("HEARTBEAT-FAILED %s rc=%d" % (which, rc))

    def guarded(self, fn, label, *args):
        try:
            fn(*args)
        except Exception as e:  # fail-closed: a crash in one stage is visible, never silent
            self.error((label, repr(e)), "%s: internal error: %r" % (label, e))

    def run(self):
        a = self.a
        start = time.time()
        next_state = next_hb = start
        while True:
            now = time.time()
            if now - start >= a.max_secs:
                break
            if now >= next_hb:
                self.guarded(self.heartbeat, "heartbeat")
                next_hb = time.time() + a.heartbeat_secs
            self.guarded(self.poll_relay, "relay", now)
            if now >= next_state:
                self.guarded(self.poll_state, "state", now)
                next_state = now + a.state_secs
            time.sleep(max(0.0, min(a.poll_secs, start + a.max_secs - time.time())))
        out("EXPIRED re-arm")


def main():
    a = parse_args()
    Watch(a).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
